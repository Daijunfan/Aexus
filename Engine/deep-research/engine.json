{
  "id": "deep-research",
  "name": "Deep Research",
  "version": "2.0.0",
  "contractVersion": "1.0.0",
  "description": "动态规划的多 Agent 深度研究引擎。并行执行研究任务，独立获取并核对来源摘录，展示研究过程与证据，交付结构化报告。",
  "ui": "Page.tsx",
  "cli": "cli.mjs",
  "runtime": "runtime.mjs",
  "requiredCommands": [
    "workflow.start",
    "workflow.list",
    "workflow.get",
    "workflow.respond",
    "workflow.resume",
    "workflow.cancel",
    "workflow.pause",
    "workflow.amend",
    "workflow.file",
    "engine.check",
    "group.list",
    "group.add",
    "card.create",
    "session.list",
    "session.status",
    "session.send",
    "session.transcript",
    "session.interrupt",
    "session.dequeue",
    "management.bind",
    "management.unbind",
    "view.open"
  ],
  "inputSchema": {
    "type": "object",
    "required": ["topic"],
    "additionalProperties": false,
    "properties": {
      "topic": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000,
        "description": "研究主题或问题"
      },
      "scope": {
        "type": "string",
        "enum": ["quick", "comprehensive", "deep", "academic"],
        "default": "comprehensive",
        "description": "研究范围：快速概览、全面调查、深度分析、学术研究"
      },
      "maxSources": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000,
        "default": 80,
        "description": "最大来源数量；快速模式未填写时默认 6，其他模式默认 80"
      },
      "languages": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": ["zh-CN", "en", "ja", "es", "fr", "de"]
        },
        "minItems": 1,
        "default": ["zh-CN", "en"],
        "description": "搜索语言"
      },
      "materials": {
        "type": "array",
        "maxItems": 10,
        "items": {
          "type": "object",
          "required": ["name", "content"],
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 200
            },
            "content": {
              "type": "string",
              "maxLength": 200000
            }
          }
        },
        "description": "背景材料（可选）"
      },
      "engines": {
        "type": "array",
        "minItems": 1,
        "maxItems": 5,
        "items": {
          "type": "object",
          "required": ["engine"],
          "properties": {
            "engine": {
              "enum": ["codex", "claude", "cline", "pi"]
            },
            "model": {
              "type": "string",
              "maxLength": 200
            }
          }
        },
        "description": "指定 Coding Agent 引擎（可选）"
      },
      "autoApprove": {
        "type": "boolean",
        "default": false,
        "description": "自动批准中间步骤（快速模式）"
      },
      "team": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "maxWorkers": { "type": "integer", "minimum": 2, "maximum": 64, "default": 12, "description": "全面模式默认 12，快速模式默认 4" },
          "maxManagers": { "type": "integer", "minimum": 1, "maximum": 16, "default": 4, "description": "全面模式默认 4，快速模式默认 1" },
          "maxConcurrency": { "type": "integer", "minimum": 1, "maximum": 32, "default": 4, "description": "全面模式默认 4，快速模式默认 2" }
        }
      },
      "maxTasks": { "type": "integer", "minimum": 4, "maximum": 512, "default": 128, "description": "全面模式默认 128，快速模式默认 16" },
      "maxReplans": { "type": "integer", "minimum": 0, "maximum": 20, "default": 3, "description": "全面模式默认 3，快速模式默认 1" }
    }
  },
  "outputSchema": {
    "type": "object",
    "required": ["id", "status", "files"],
    "properties": {
      "id": {
        "type": "string"
      },
      "status": {
        "const": "completed"
      },
      "files": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["name", "mediaType", "bytes", "sha256"],
          "properties": {
            "name": {
              "type": "string"
            },
            "mediaType": {
              "type": "string"
            },
            "bytes": {
              "type": "integer"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    }
  }
}
