@@ -62,6 +65,21 @@ int guacd_send_fd(int sock, int fd) {
     ssize_t result;
     GUAC_RETRY_EINTR(result, sendmsg(sock, &message, 0));
 
+#ifdef __APPLE__
+    /* Darwin may disconnect an in-flight socket when the sender closes its
+     * last descriptor. Keep it open until recvmsg() has installed the copy. */
+    if (result == sizeof(message_data)) {
+        struct pollfd pending = {.fd = sock, .events = POLLIN};
+        int ready;
+        GUAC_RETRY_EINTR(ready, poll(&pending, 1, 15000));
+        if (ready <= 0)
+            return 0;
+        char acknowledged;
+        GUAC_RETRY_EINTR(result, recv(sock, &acknowledged, 1, 0));
+        return result == 1 && acknowledged == 'A';
+    }
+#endif
+
     return (result == sizeof(message_data));
 
 }
