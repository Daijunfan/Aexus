{
  "name": "agents-company-margin-reader",
  "version": "0.7.0",
  "private": true,
  "description": "CLI-first, local-first document reader plugin for Agents Company",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "margin-reader": "cli.cjs"
  },
  "scripts": {
    "build:plugin": "node scripts/build.cjs",
    "check": "node scripts/check.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node tests/ui-smoke.cjs",
    "test:host": "node tests/host-smoke.cjs",
    "test:employee": "node tests/employee-host.cjs",
    "test:team-ui": "node tests/team-ui.cjs",
    "test:agent-acceptance": "npm run build:plugin && npm test && npm run test:host && npm run test:employee && npm run test:ui && npm run test:team-ui && npm run test:av && npm run test:av:native && npm run test:presentation && npm run test:review-faces && npm run test:generated-review && npm run test:mapping-repair && npm run test:ruler && npm run test:ink-toolbar && npm run test:ink-preferences && npm run test:scribble && npm run test:stroke-geometry && npm run test:eraser-workflow && npm run test:image-ink && npm run test:image-marks && npm run test:review-faces:native && npm run test:dictionary && npm run test:backup-stream-ui && npm run test:appearance && npm run test:keyword-boards && npm run test:interaction && npm run test:backup-jobs-ui && npm run test:interaction:native && npm run test:card-source && npm run test:book-turn && npm run test:study-library && npm run test:book-library:native && npm run test:mindmap-ui && npm run test:mindmap-native && npm run test:sidebar",
    "test:live": "node tests/live-smoke.cjs",
    "test:acceptance": "node scripts/verify-local-import.cjs",
    "test:blog-ui": "node scripts/verify-blog-ui.cjs",
    "test:pdf-modes": "node tests/pdf-modes-ui.cjs",
    "test:library": "node tests/library-ui.cjs",
    "test:library:native": "LIBRARY_NATIVE=1 node tests/library-ui.cjs",
    "test:selection": "node tests/selection-ui.cjs",
    "test:selection:native": "SELECTION_NATIVE=1 node tests/selection-ui.cjs",
    "test:study": "node tests/study-ui.cjs",
    "test:study:native": "STUDY_NATIVE=1 node tests/study-ui.cjs",
    "test:workbench": "node tests/workbench-ui.cjs",
    "test:advanced": "node tests/advanced-ui.cjs",
    "test:advanced:native": "WORKBENCH_NATIVE=1 node tests/advanced-ui.cjs",
    "test:av": "node tests/av-ui.cjs",
    "test:av:native": "node tests/av-native-ui.cjs",
    "test:presentation": "node tests/presentation-pointers-ui.cjs",
    "test:review-faces": "node tests/review-faces-ui.cjs",
    "test:review-faces:native": "node tests/review-faces-native-ui.cjs",
    "test:image-marks": "node tests/image-marks-ui.cjs",
    "test:generated-review": "node tests/generated-review-ui.cjs",
    "test:mapping-repair": "node tests/mapping-repair-ui.cjs",
    "test:image-ink": "node tests/image-ink-ui.cjs",
    "test:eraser-workflow": "node tests/eraser-workflow-ui.cjs",
    "test:stroke-geometry": "node tests/stroke-geometry-ui.cjs",
    "test:scribble": "node tests/scribble-ui.cjs",
    "test:ink-preferences": "node tests/ink-preferences-ui.cjs",
    "test:ink-toolbar": "node tests/ink-toolbar-ui.cjs",
    "test:ruler": "node tests/ruler-ui.cjs",
    "test:deep-audit": "npm run build:plugin && node scripts/deep-audit.cjs",
    "test:large-map": "node tests/large-map-ui.cjs",
    "test:annotations": "node tests/annotation-window-ui.cjs",
    "test:performance": "node tests/performance-profile.cjs current",
    "test:dictionary": "node tests/dictionary-document-ui.cjs && node tests/dictionary-selection-ui.cjs",
    "test:backup-stream": "node --test tests/backup-stream.test.cjs",
    "test:backup-stream-ui": "node tests/backup-stream-ui.cjs",
    "test:backup-large": "node tests/backup-large.cjs",
    "test:appearance": "node tests/visual-refinement-ui.cjs && node tests/library-stability-ui.cjs",
    "test:keyword-boards": "node tests/keyword-boards-ui.cjs",
    "test:interaction": "node tests/appearance-portable-ui.cjs && node tests/interaction-workbench-ui.cjs && node tests/document-textbox-ui.cjs",
    "test:backup-jobs": "node --test tests/backup-jobs.test.cjs",
    "test:backup-jobs-ui": "node tests/backup-jobs-ui.cjs",
    "test:backup-crash": "node tests/backup-job-crash.cjs",
    "test:backup-job-large": "node tests/backup-job-large.cjs",
    "test:interaction:native": "node tests/interaction-native-ui.cjs",
    "test:card-source": "node tests/card-source-click-ui.cjs",
    "diagnose:loaded": "node scripts/check-loaded.cjs",
    "test:book-turn": "node tests/book-turn-ui.cjs",
    "test:study-library": "node tests/study-library-ui.cjs",
    "test:book-library:native": "node tests/book-library-native-ui.cjs",
    "test:mindmap": "node --test tests/mindmap.test.cjs tests/mindmap-tools.test.cjs tests/mindmap-stability.test.cjs",
    "test:mindmap-ui": "node tests/mindmap-studio-ui.cjs && node tests/mindmap-tools-ui.cjs && node tests/mindmap-image-ui.cjs && node tests/mindmap-motion-ui.cjs",
    "test:mindmap-native": "node tests/mindmap-native-ui.cjs",
    "test:mindmap-performance": "node tests/mindmap-performance.cjs",
    "test:sidebar": "node tests/sidebar-navigation-ui.cjs"
  },
  "dependencies": {
    "@lingo-reader/mobi-parser": "0.4.6",
    "@mozilla/readability": "0.6.0",
    "@napi-rs/canvas": "0.1.100",
    "@open-spaced-repetition/binding": "0.5.0",
    "iconv-lite": "0.6.3",
    "ipaddr.js": "2.2.0",
    "jsdom": "26.1.0",
    "jszip": "3.10.1",
    "katex": "0.18.9",
    "mammoth": "1.12.3",
    "marked": "15.0.12",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.624",
    "proper-lockfile": "4.1.2",
    "sanitize-html": "2.17.7",
    "ts-fsrs": "5.4.2",
    "word-extractor": "1.0.4"
  }
}
