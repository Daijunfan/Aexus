{
  "name": "mini-notion",
  "version": "1.17.2",
  "description": "A thoughtful, local-first workspace for macOS",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Mini Notion",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && node scripts/backend.mjs && vite build",
    "start": "node scripts/start.mjs",
    "test": "node scripts/backend.mjs && node scripts/test.mjs",
    "test:e2e": "npm run build && node scripts/icon.mjs && playwright test",
    "package": "npm run build && node scripts/icon.mjs && node scripts/source.mjs && electron-builder --mac --arm64",
    "typecheck": "tsc -b",
    "format": "prettier --write src electron scripts tests *.json *.ts *.html *.md",
    "build:backend": "node scripts/backend.mjs",
    "cli": "node dist-cli/cli.cjs",
    "test:agent:live": "node scripts/backend.mjs && node tests/agent-live.cjs",
    "build:plugin": "node scripts/backend.mjs && node scripts/plugin.mjs",
    "test:folder": "node scripts/backend.mjs && node --test tests/folder.test.cjs",
    "test:folder-ui": "node scripts/test-folder-ui.mjs",
    "test:local": "node scripts/backend.mjs && node --test tests/folder.test.cjs tests/local-notion.test.cjs tests/notion-editing.test.cjs",
    "test:local-ui": "node scripts/test-local-ui.mjs",
    "test:domain": "node scripts/test-domain.mjs",
    "test:editing-ui": "node scripts/test-editing-ui.mjs"
  },
  "dependencies": {
    "@blocknote/server-util": "^0.54.2",
    "@blocknote/xl-multi-column": "^0.54.2",
    "@js-temporal/polyfill": "^0.5.1",
    "jszip": "^3.10.1",
    "katex": "0.18.9",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7"
  },
  "devDependencies": {
    "@blocknote/core": "0.54.2",
    "@blocknote/mantine": "0.54.2",
    "@blocknote/react": "0.54.2",
    "@mantine/core": "^8.3.11",
    "@mantine/hooks": "^8.3.11",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "commander": "^15.0.0",
    "electron": "44.3.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "jsep": "^1.4.0",
    "lucide-react": "^0.577.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "shiki": "^4.4.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.269"
  },
  "build": {
    "appId": "local.mininotion.desktop",
    "productName": "Mini Notion",
    "directories": {
      "output": "release.noindex"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md",
      "UNICODE-LICENSE.txt",
      "LICENSE",
      "dist-cli/**/*",
      "KATEX-LICENSE.txt"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk-*/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "darkModeSupport": true,
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Mini Notion",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 180
        },
        {
          "x": 390,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "electronDist": "node_modules/electron/dist",
    "protocols": [
      {
        "name": "Mini Notion page",
        "schemes": [
          "mininotion"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "build/Source.zip",
        "to": "Source.zip"
      },
      {
        "from": "build/cli",
        "to": "cli"
      }
    ]
  }
}
