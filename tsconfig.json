{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": [
      "node",
      "electron-vite/node"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "electron.vite.config.ts",
    "Infra/src/main/**/*",
    "Infra/src/preload/**/*",
    "Infra/src/renderer/src/**/*",
    "Contract/**/*.ts",
    "Engine/**/*.tsx"
  ]
}
