{
  "name": "aexus",
  "productName": "Aexus",
  "version": "0.64.0",
  "description": "Aexus: domain-specific engines on a CLI-first multi-Agent infrastructure",
  "main": "./.aexus/out/main/index.js",
  "author": {
    "name": "Aexus",
    "email": "Daijunfan@users.noreply.github.com"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "setup": "node Infra/src/tooling/setup.mjs",
    "build:engines": "node Infra/src/tooling/build-engines.mjs",
    "build:plugins": "node Infra/src/tooling/build-plugins.mjs",
    "build:plugins:release": "node Infra/src/tooling/build-plugins.mjs --release",
    "build:server": "node Infra/src/tooling/build-server.mjs",
    "build:web": "vite build --config vite.web.config.ts",
    "contract:sync": "node Infra/src/tooling/sync-contract.mjs",
    "contract:check": "node Infra/src/tooling/sync-contract.mjs --check",
    "test:contract": "node Infra/src/test/aexus-contract-core-test.mjs",
    "test:boundaries": "node Infra/src/test/aexus-boundaries-test.mjs",
    "test:layers": "node Infra/src/test/aexus-layers-ui-test.mjs",
    "test:engine-scope": "node Infra/src/tooling/run-tests.mjs scope",
    "test:release-core": "node Infra/src/tooling/run-tests.mjs core",
    "test:release-ui": "node Infra/src/tooling/run-tests.mjs ui",
    "test:release-engines": "node Infra/src/tooling/run-tests.mjs engines",
    "test:coverage": "node Infra/src/test/coverage-test.mjs",
    "test:deep-research": "node --test Infra/src/test/retired-research-unit-test.mjs && node Infra/src/test/retired-research-core-test.mjs",
    "test:deep-research-ui": "node Infra/src/test/retired-research-ui-test.mjs",
    "release:check": "node Infra/src/tooling/release-check.mjs",
    "release:source": "node Infra/src/tooling/package-source.mjs",
    "serve": "node Infra/src/cli/agents serve",
    "app": "node Infra/src/tooling/package-desktop.mjs --dir --development",
    "dist": "node Infra/src/tooling/package-desktop.mjs",
    "install:mac": "node Infra/src/tooling/install-app.mjs",
    "docs:managers": "node Infra/src/tooling/sync-manager-docs.mjs",
    "test:manager-docs": "node Infra/src/tooling/sync-manager-docs.mjs --check && node Infra/src/test/manager-cli-test.mjs && node Infra/src/test/manager-agent-test.mjs && node Infra/src/test/manager-claude-test.mjs",
    "test:cli": "node Infra/src/test/cli-test.mjs",
    "dev:headless": "AGENTS_COMPANY_HEADLESS=1 electron-vite dev",
    "test": "npm run typecheck && npm run build && npm run test:coverage && npm run test:release-core"
  },
  "build": {
    "appId": "com.agentscompany.app",
    "productName": "Aexus",
    "directories": {
      "output": ".aexus/release"
    },
    "files": [
      ".aexus/out/**/*",
      "package.json",
      "Infra/src/cli/**/*",
      "Infra/src/docs/API.md",
      "Infra/src/docs/managers/**/*",
      "Infra/src/docs/PLUGIN_SPEC.md",
      "README.md",
      "Infra/src/examples/plugin-starter/**/*",
      "Infra/src/docs/THIRD_PARTY_NOTICES.md",
      "Infra/src/licenses/**/*",
      "Infra/src/renderer/src/assets/pets/sources.json",
      "Infra/src/renderer/src/assets/engines/**/*",
      "Infra/src/docs/AGENTS.md",
      "Infra/src/docs/SCHEDULER.md",
      "Infra/src/docs/ENGINE_CAPABILITIES.md",
      "Infra/src/renderer/src/assets/pets/licenses/**/*",
      "Infra/src/docs/ARCHITECTURE.md",
      "Infra/src/docs/PERMISSIONS.md",
      "LICENSE",
      "NOTICE",
      "Infra/src/docs/LICENSING.md",
      "Infra/src/docs/SECURITY.md",
      "Infra/src/docs/DEPLOYMENT.md",
      "Infra/src/docs/CHANNELS.md",
      "Infra/src/resources/engine-downloads.json",
      "Infra/src/docs/PLAN.md",
      "Infra/src/docs/PLAN_SCENARIOS.md",
      "Infra/src/docs/PLAN_VIEW_PARITY.md",
      "Infra/src/docs/CONVERSATION_WORKSPACES.md",
      "Infra/src/docs/SECRETARY_API_PARITY.md",
      "Infra/src/docs/CONVERSATION_CONTROLS.md",
      "Infra/src/docs/MESSAGE_COLLABORATION.md",
      "Infra/src/docs/FILES_WORKBENCH.md",
      "Infra/src/docs/releases/0.57.0.zh-CN.md",
      "Infra/src/docs/releases/0.58.0.zh-CN.md",
      "Contract/**/*",
      "Engine/**/*",
      "Infra/src/docs/INFRA_API.md",
      "Infra/src/docs/ENGINE_WORKSPACES.md",
      "Infra/src/docs/releases/0.59.0.zh-CN.md",
      "Infra/src/docs/README.en.md",
      "Infra/src/docs/releases/0.60.0.zh-CN.md",
      "Infra/src/docs/releases/0.60.1.zh-CN.md",
      "Engine/*/node_modules/**/*",
      "!Engine/**/node_modules/**/{test,tests,__tests__,examples,example,benchmark,benchmarks}/**",
      "!Engine/**/node_modules/.bin/**",
      "!Engine/**/node_modules/**/*.map",
      "Infra/src/docs/releases/0.63.0.zh-CN.md"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": null,
      "icon": "Infra/src/resources/icon.icns",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "仅在你点击录音后使用麦克风。Recording starts only when you choose to record.",
        "NSCameraUsageDescription": "允许网页聊天在你同意后使用摄像头。"
      },
      "entitlements": "Infra/src/resources/entitlements.mac.plist",
      "entitlementsInherit": "Infra/src/resources/entitlements.mac.plist"
    },
    "extraResources": [
      {
        "from": "Infra/src/resources/DISTRIBUTION.json",
        "to": "DISTRIBUTION.json"
      },
      {
        "from": "Infra/src/resources/plugins",
        "to": "plugins",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "Infra/src/resources/cli",
        "to": "cli"
      },
      {
        "from": "Infra/src/tunnel",
        "to": "Modules/Tunnel",
        "filter": [
          "*.py",
          "README.md",
          "profiles/*.example.json",
          "windows/*.ps1",
          "windows/*.cs"
        ]
      }
    ],
    "electronDist": "node_modules/electron/dist",
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk-*/**/*",
      "node_modules/node-pty/**/*",
      "Engine/*/node_modules/**/*",
      "Engine/deep-research/document-worker.mjs",
      "Engine/deep-research/export-worker.mjs"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "Infra/src/resources/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "Infra/src/resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@vscode/codicons": "0.0.46-24",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cross-spawn": "7.0.6",
    "pdfjs-dist": "^6.4.299",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "tar": "7.5.22",
    "tiny-pinyin": "1.3.2",
    "unified": "11.0.5",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.272",
    "@playwright/test": "^1.58.2",
    "@tanstack/react-virtual": "3.14.13",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.4.4",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "emojibase-data": "17.0.0",
    "esbuild": "0.25.12",
    "highlight.js": "11.12.0",
    "katex": "0.18.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "remark-math": "6.0.0",
    "sharp": "0.35.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "zod": "4.6.5"
  },
  "bin": {
    "aexus": "./Infra/src/cli/aexus",
    "agents": "./Infra/src/cli/agents",
    "avalon": "./Infra/src/cli/avalon",
    "anexus": "./Infra/src/cli/anexus"
  },
  "optionalDependencies": {
    "node-pty": "1.1.0"
  },
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22.18.0"
  },
  "homepage": "https://github.com/Daijunfan/Aexus"
}
