  commands run <id> /command [args]      execute a slash command
  commands list <id> [--filter X] [--all] the slash commands available
  commands complete <id> <name>           what Tab would insert
  ui view                                 what is on screen
  ui dom [--sel CSS]                      query the interface
  ui text                                 all visible text
  ui click <selector>                     click something
  ui type <selector> <text>               type into an input
  ui wait <selector> [--timeout ms]       wait for an element
  ui style <selector>                     computed styles of an element
  ui screenshot <path>                    save the rendered interface as PNG
`

let onEvent = (m) => {
  if (useJson) console.log(JSON.stringify(m.payload))
  else if (m.channel === 'session:codex') {
    const e = m.payload.event
    if (e.kind === 'text') process.stdout.write(e.text)
    else if (e.kind === 'tool-start') console.log(`\n  $ ${e.command}`)
    else if (e.kind === 'tool-end') console.log(`  → exit ${e.exitCode}`)
  } else if (m.channel === 'session:message') {
    const msg = m.payload.message
    if (msg.type === 'assistant') {
      for (const c of msg.message?.content ?? []) {
        if (c.type === 'text') process.stdout.write(c.text)
        else if (c.type === 'tool_use') console.log(`\n  ⚙ ${c.name}`)
      }
    }
  } else if (m.channel === 'session:turn-end' || m.channel === 'session:end') {
    console.log()
  }
}

async function main() {
  const [group, sub, ...rest] = argv
  if (!group || group === 'help' || group === '--help') {
    console.log(HELP)
    return
  }

  const call = (cmd, args) => send({ cmd, args })

  switch (`${group}${sub && !sub.startsWith('-') ? '.' + sub : ''}`) {
    case 'schedule.schema': case 'schedule.status': return out(await call(`schedule.${sub}`))
    case 'schedule.list': { const p=parse(rest); return out(await call('schedule.list',{employee:p.employee,source:p.source})) }
    case 'schedule.get': case 'schedule.pause': case 'schedule.resume': case 'schedule.delete': case 'schedule.run': case 'schedule.cancel': return out(await call(`schedule.${sub}`,{id:rest[0]}))
    case 'schedule.create': { const p=parse(rest);return out(await call('schedule.create',{spec:scheduleSpec(p)})) }
    case 'schedule.update': { const p=parse(rest);return out(await call('schedule.update',{id:p._[0],patch:jsonArgument(p.patch)})) }
    case 'schedule.preview': { const p=parse(rest);return out(await call('schedule.preview',{id:p._[0],spec:p.spec?jsonArgument(p.spec):undefined,after:p.after,count:p.count===undefined?undefined:Number(p.count)})) }
    case 'schedule.history': { const p=parse(rest);return out(await call('schedule.history',{id:p._[0],employee:p.employee,limit:p.limit===undefined?undefined:Number(p.limit)})) }
    case 'session.rename': return out(await call('session.rename',{id:rest[0],title:rest[1]}))
    case 'settings.get': return out(await call('settings.get'))
    case 'settings.set': {
      const p=parse(rest),a={};if(p.theme!==undefined)a.theme=p.theme;for(const [key,flag] of [['explorerWidth','explorer-width'],['terminalHeight','terminal-height'],['pageZoom','page-zoom'],['zoomSensitivity','zoom-sensitivity'],['panSensitivity','pan-sensitivity'],['sidebarWidth','sidebar-width']])if(p[flag]!==undefined)a[key]=Number(p[flag]);if(p['snap-employees']!==undefined){if(!['on','off'].includes(p['snap-employees']))throw new Error('--snap-employees accepts on|off');a.snapEmployees=p['snap-employees']==='on'}return out(await call('settings.set',a))
    }
    case 'view.get':case 'view.close': return out(await call(`view.${sub}`))
    case 'view.open': {
      const p=parse(rest);return out(await call('view.open',{kind:p._[0],name:p.name,employee:p.employee,pluginId:p.plugin,settings:p.mode?{mode:p.mode,pluginId:p.plugin,remote:remoteFlags(p)}:undefined,details:!!p.details}))
    }
    case 'view.details': return out(await call('view.details',{enabled:rest[0]==='on'}))
    case 'remote.check': {const p=parse(rest);return out(await call('remote.check',{employee:p.employee,team:p.team,remote:remoteFlags(p)}))}
    case 'terminal.open': {const p=parse(rest);return out(await call('terminal.open',{employee:p.employee,cols:p.cols?Number(p.cols):undefined,rows:p.rows?Number(p.rows):undefined}))}
    case 'terminal.list': {const p=parse(rest);return out(await call('terminal.list',{employee:p.employee}))}
    case 'terminal.read': {const p=parse(rest);return out(await call('terminal.read',{id:p._[0],cursor:Number(p.cursor??0)}),r=>r.output)}
    case 'terminal.input': {const p=parse(rest),data=p.file?require('node:fs').readFileSync(p.file,'utf8'):p.data??p._[1]??'';return out(await call('terminal.input',{id:p._[0],data:data+(p.enter?'\r':'')}))}
    case 'terminal.resize': {const p=parse(rest);return out(await call('terminal.resize',{id:p._[0],cols:Number(p.cols),rows:Number(p.rows)}))}
    case 'terminal.close': return out(await call('terminal.close',{id:rest[0]}))
    case 'workspace.suggest':case 'workspace.choose': {
      const p=parse(rest);return out(await call(`workspace.${sub}`,{team:p.team,path:p.path,mode:p.mode,pluginId:p.plugin,remote:remoteFlags(p)}))
    }
    case 'workspace.image':case 'workspace.list':case 'workspace.read':case 'workspace.write':case 'workspace.mkdir':case 'workspace.move':case 'workspace.trash':case 'workspace.restore': {
      const p=parse(rest),content=p.file?require('node:fs').readFileSync(p.file,'utf8'):p.content
      return out(await call(`workspace.${sub}`,{team:p.team,employee:p.employee,path:p._[0]??p.path,to:p.to,content,hash:p.hash,create:!!p.create,hidden:!!p.hidden,id:p.id}))
    }
    case 'serve':
      require(join(__dirname, '..', 'out', 'main', 'daemon.js'))
      return
    case 'plugin.list':
      return out(await call('plugin.list'))
    case 'plugin.describe':
      return out(await call('plugin.describe',{id:rest[0]}))
    case 'plugin.install':
      return out(await call('plugin.install',{path:rest[0]}))
    case 'plugin.call': {
      const p=parse(rest)
      const params=p.params ? JSON.parse(String(p.params).startsWith('@')?require('node:fs').readFileSync(String(p.params).slice(1),'utf8'):String(p.params)) : {}
      return out(await call('plugin.call',{id:p._[0],method:p._[1],team:p.team,workspace:p.workspace,employee:p.employee,params}))
    }
    case 'plugin.windows': return out(await call('plugin.windows'))
    case 'plugin.dismiss': return out(await call('plugin.dismiss',{id:rest[0]}))
    case 'plugin.mode': return out(await call('plugin.mode',{id:rest[0],mode:rest[1]}))
    case 'plugin.place': {const p=parse(rest),bounds={};for(const key of ['x','y','width','height'])if(p[key]!==undefined)bounds[key]=Number(p[key]);return out(await call('plugin.place',{id:p._[0],bounds}))}
    case 'plugin.open': {const p=parse(rest);return out(await call('plugin.open',{id:p._[0],team:p.team,employee:p.employee,workspace:p.workspace}))}
    case 'plugin.view': {
      const p=parse(rest)
      return out(await call('plugin.view',{id:p._[0],team:p.team,workspace:p.workspace,employee:p.employee}))
    }
    case 'plugin.close':
      return out(await call('plugin.close',{viewId:rest[0]}))
    case 'workspace.docs': {
      const p=parse(rest)
      return out(await call('workspace.docs',{team:p.team,workspace:p.workspace,employee:p.employee}))
    }
    case 'status':
      return out(await call('status'), (d) =>
        `running   ${d.running}\nhome      ${d.home}\nteamRoots ${Object.keys(d.teamRoots ?? {}).length}\nlive      ${d.live}\nstored    ${d.stored}`
      )

    case 'session.list': {
      const p = parse(argv.slice(1))
      const d = await call('session.list', { live: !!p.live })
      if (p.live)
        return out(d, (rows) =>
          table(rows, [
            { key: 'id', label: 'ID' },
            { key: 'engine', label: 'ENGINE' },
            { key: 'busy', label: 'BUSY' }
          ])
        )
      return out(d, (s) =>
        table(s.sessions, [
          { key: 'id', label: 'ID' },
          { key: 'engine', label: 'ENGINE' },
          { key: 'group', label: 'DEPARTMENT' },
          { key: 'title', label: 'TITLE' }
        ]) + `\n\ndepartments: ${s.groups.join(', ') || '(none)'}`
      )
    }

    case 'session.new': {
      const p = parse(argv.slice(1))
      const d = await call('session.new', {
        engine: p.engine,
        group: p.group,
        model: p.model,
        cwd: p.cwd,
        directoryMode:p['directory-mode'],remote:remoteFlags(p),
        title: p.title,
        seat: p.seat,
        permissionMode: p.permission,
        effort: p.effort,
        thinking: p.thinking === undefined ? undefined : p.thinking === 'on'
      })
      return out(d, (x) => `${x.sessionId}  ${x.engine}  ${x.cwd}`)
    }

    case 'session.open':
      return out(await call('session.open', { cardId: rest[0] }), (x) => `${x.sessionId}  open`)

    case 'session.activity': return out(await call('session.activity',{id:rest[0]}))
    case 'session.snapshot':
      return out(await call('session.snapshot', { id: rest[0] }))
    case 'session.search':
      return out(await call('session.search', { query: rest.join(' ') }))
    case 'approval.list':
      return out(await call('approval.list', { id: rest[0] }))
    case 'approval.respond': {const p=parse(rest);return out(await call('approval.respond',{id:p._[0],requestId:p._[1],decision:p._[2],answers:p.answers?JSON.parse(p.answers):undefined,form:p.form?JSON.parse(p.form):undefined}))}

    case 'session.send': {const parts=rest.slice(1),at=parts.indexOf('--images');let images;if(at>=0){images=JSON.parse(parts[at+1]);parts.splice(at,2)}return out(await call('session.send',{id:rest[0],text:parts.join(' '),images}))}
    case 'chatter.status': return out(await call('chatter.status',{id:rest[0]}))
    case 'chatter.open-chrome': case 'chatter.chrome-status': case 'chatter.close-chrome':return out(await call(`chatter.${sub}`,{id:rest[0]}))
    case 'chatter.login': return out(await call('chatter.login',{id:rest[0]}))
    case 'chatter.import': {const p=parse(rest);if(!p.file)throw new Error('Use --file cookies.json');return out(await call('chatter.import',{id:p._[0],cookies:JSON.parse(require('node:fs').readFileSync(p.file,'utf8'))}))}
    case 'chatter.migrate': {const p=parse(rest);if(!p.account&&!p.profile)throw new Error('Use --account EMAIL or --profile NAME');return out(await call('chatter.migrate',{id:p._[0],account:p.account,profile:p.profile}))}
    case 'chatter.current': case 'chatter.view': case 'chatter.inspect': case 'chatter.screenshot':return out(await call(`chatter.${sub}`,{id:rest[0]}))
    case 'chatter.bind':return out(await call('chatter.bind',{id:rest[0],url:rest[1]}))
    case 'chatter.attach':return out(await call('chatter.attach',{id:rest[0],webContentsId:Number(rest[1])}))
    case 'chatter.click': case 'chatter.fill': case 'chatter.press': case 'chatter.upload': {const p=parse(rest);return out(await call(`chatter.${sub}`,{id:p._[0],selector:p.selector,value:p.value,key:p.key,path:p.path}))}
    case 'chatter.run': {const p=parse(rest);return out(await call('chatter.run',{id:p._[0],steps:jsonArgument(p.steps)}))}
    case 'chatter.sync': {const p=parse(rest);if(!p.file)throw new Error('Use --file state.json');return out(await call('chatter.sync',{id:p._[0],...JSON.parse(require('node:fs').readFileSync(p.file,'utf8'))}))}

    case 'session.transcript': {
      const p = parse(argv.slice(1))
      return out(await call('session.transcript', { id: p._[1] ?? rest[0], thinking: !!p.thinking }), (d) => d.text)
    }

    case 'session.info':
      return out(await call('session.info', { id: rest[0] }), (d) =>
        [
          `engine      ${d.engine}`,
          `model       ${d.model ?? '(default)'}`,
          `permission  ${d.permissionMode}`,
          `thinking    ${d.thinkingSupported ? (d.thinking ? 'on' : 'off') : 'n/a'}`,
          `effort      ${d.effort ?? '(default)'}`,
          `speed       ${d.fastMode ? 'Fast' : 'Standard'}`,
          `busy        ${d.busy}`,
          `models      ${d.models.map((m) => m.value).join(', ') || '(none)'}`,
          `commands    ${d.commands.length} available`
        ].join('\n')
      )

    case 'session.interrupt':
      return out(await call('session.interrupt', { id: rest[0] }))
    case 'session.close':
      return out(await call('session.close', { id: rest[0] }))

    case 'session.follow': {
      const p = parse(argv.slice(1))
      const id = p._[1] ?? rest[0]
      const res = await send({ cmd: 'session.follow', args: { id, raw: !!p.raw } }, { stream: true })
      if (useJson) console.log(JSON.stringify({ type: 'snapshot', ...res.initial }))
      else if (res.initial.text) console.log(res.initial.text)
      // The server ends the stream on completion, failure, or close.
      process.on('SIGINT', () => {
        res.stream.end()
        process.exit(0)
      })
      return
    }

    case 'config.engine': return out(await call('config.engine',{id:rest[0],engine:rest[1]}))
    case 'config.model':
      return out(await call('config.model', { id: rest[0], model: rest[1] }))
    case 'config.permission':
      return out(await call('config.permission', { id: rest[0], mode: rest[1] }))
    case 'config.thinking':
      return out(await call('config.thinking', { id: rest[0], enabled: rest[1] }))
    case 'config.effort':
      // 'default' clears the override, like the Default entry in the GUI menu.
      return out(await call('config.effort', { id: rest[0], effort: rest[1] ?? 'default' }))

    case 'config.plan': {if(!['on','off'].includes(rest[1]))throw new Error('Use on|off');return out(await call('config.plan',{id:rest[0],enabled:rest[1]==='on'}))}
    case 'external.open': return out(await call('external.open',{url:rest[0]}))
    case 'engine.inspect': return out(await call('engine.inspect',{id:rest[0],section:rest[1]}))
    case 'engine.skill': return out(await call('engine.skill',{id:rest[0],name:rest[1],prompt:rest.slice(2).join(' ')}))
    case 'session.steer': return out(await call('session.steer',{id:rest[0],text:rest.slice(1).join(' ')}))
    case 'session.background': return out(await call('session.background',{id:rest[0]}))
    case 'session.background-stop': {const p=parse(rest);return out(await call('session.background-stop',{id:p._[0],processId:p.process}))}
    case 'session.review': {const p=parse(rest);return out(await call('session.review',{id:p._[0],base:p.base,commit:p.commit,instructions:p.instructions}))}
    case 'session.enqueue': {const parts=rest.slice(1),at=parts.indexOf('--images');let images;if(at>=0){images=JSON.parse(parts[at+1]);parts.splice(at,2)}return out(await call('session.enqueue',{id:rest[0],text:parts.join(' '),images}))}
    case 'session.queue': return out(await call('session.queue',{id:rest[0]}))
    case 'session.dequeue': return out(await call('session.dequeue',{id:rest[0],messageId:rest[1]}))
    case 'session.export': {const p=parse(rest);return out(await call('session.export',{id:p._[0],format:p.format,path:p.path}),d=>d.content??JSON.stringify(d))}
    case 'view.tools': return out(await call('view.tools',{section:rest[0]==='off'?null:rest[0]}))
    case 'config.fast': {if(!['on','off'].includes(rest[1]))throw new Error('Use on|off');return out(await call('config.fast',{id:rest[0],enabled:rest[1]==='on'}))}
    case 'commands.run': return out(await call('commands.run',{id:rest[0],text:rest.slice(1).join(' ')}))
    case 'commands.list': {
      const p = parse(argv.slice(1))
      const id = p._[1] ?? rest[0]
      const rows = await call('commands.list', { id, filter: p.filter, all: !!p.all })
      return out(rows, (r) =>
        r.length
          ? r.map((c) => `/${c.name}${c.argumentHint ? ' ' + c.argumentHint : ''}  —  ${c.description}`).join('\n')
          : '(no matching commands)'
      )
    }

    case 'commands.complete': {
      const p = parse(argv.slice(1))
      const id = p._[1] ?? rest[0]
      const name = p._[2] ?? rest[1]
      return out(await call('commands.complete', { id, name }), (d) => d.completion)
    }

    case 'ui.style': {
      const p = parse(argv.slice(1))
      const sel = p._[1] ?? rest[0]
      return out(await call('ui.style', { selector: sel }), (d) =>
        Object.entries(d)
          .map(([k, v]) => `${k.padEnd(10)} ${v}`)
          .join('\n')
      )
    }

    case 'ui.screenshot':
      return out(await call('ui.screenshot', { path: rest[0] }))
    case 'ui.drag':
    case 'ui.wheel': {
      const p=parse(rest)
      return out(await call(`ui.${sub}`,{selector:p._[0],dx:Number(p.dx??0),dy:Number(p.dy??0),zoom:!!p.zoom}))
    }

    case 'ui.view':
      return out(await call('ui.view'), (d) => {
        const lines = [`view        ${d.view}`]
        if (d.view === 'home') {
          lines.push(`departments ${d.departments.join(', ') || '(none)'}`)
          lines.push(`cards       ${d.cards.length}`)
          for (const c of d.cards) lines.push(`  · ${c.title}  [${c.engine}]  ${c.group || 'Unassigned'}`)
        } else if (d.session) {
          const s = d.session
          lines.push(`session     ${s.title}`)
          lines.push(`engine      ${s.engine}`)
          lines.push(`model       ${s.model}`)
          lines.push(`permission  ${s.permission}`)
          lines.push(`thinking    ${s.thinking}`)
          lines.push(`busy        ${s.busy}`)
          lines.push(`turns       ${s.turns}`)
          lines.push(`back button ${s.hasBackButton ? 'yes' : 'NO'}`)
        }
        return lines.join('\n')
      })

    case 'ui.text':
      return out(await call('ui.text'), (d) => String(d))

    case 'ui.dom': {
      const p = parse(argv.slice(1))
      const sel = p.sel || p.selector || 'body'
      return out(await call('ui.dom', { selector: sel }), (rows) =>
        rows.map((r) => `${r.visible ? '●' : '○'} ${r.tag}.${String(r.cls).split(' ')[0]}  ${r.text.slice(0, 70)}`).join('\n')
      )
    }

    case 'ui.click':
      return out(await call('ui.click', { selector: rest[0] }), (d) => `clicked ${d.clicked ?? rest[0]}`)

    case 'ui.type':
      return out(await call('ui.type', { selector: rest[0], value: rest.slice(1).join(' ') }))

    case 'ui.wait': {
      const p = parse(argv.slice(1))
      // argv is ['ui','wait','<selector>'], so the selector is the second positional.
      const sel = p._[1] ?? p._[0]
      return out(await call('ui.wait', { selector: sel, timeout: p.timeout }), (d) =>
        d.found ? 'found' : 'not found'
      )
    }

    case 'room.place': {
      const p = parse(argv.slice(1))
      const name = p._[1] ?? p._[0]
      return out(
        await call('room.place', {
          name,
          col: p.col,
          row: p.row,
          w: p.w ?? 1,
          h: p.h ?? 1
        }),
        (s) => JSON.stringify(s.rooms?.[name] ?? null)
      )
    }

    case 'group.list':
      {const p=parse(rest);return out(await call('group.list',{details:!!p.details}),g=>g.map(value=>typeof value==='string'?value:`${value.name} · ${value.mode}${value.remote?' · '+value.remote.host:value.pluginId?' · '+value.pluginId:''} · ${value.root??''}`).join('\n')||'(none)')}
    case 'group.add':
      {const p=parse(rest);return out(await call('group.add', { name: rest[0], root:p.root,mode:p.mode,pluginId:p.plugin,directoryMode:p['directory-mode'],remote:remoteFlags(p) }), (s) => s.groups.join('\n'))}
    case 'group.configure':
      {const p=parse(rest);return out(await call('group.configure',{name:p._[0],mode:p.mode,pluginId:p.plugin,directoryMode:p['directory-mode'],root:p.root,remote:remoteFlags(p)}))}
    case 'group.migrate': return out(await call('group.migrate',{name:rest[0]}))
    case 'group.root':
      return out(await call('group.root',{name:rest[0],root:rest[1],create:!!parse(rest).create,directoryMode:parse(rest)['directory-mode']}))
    case 'room.bounds': {
      const p=parse(rest), bounds={}
      for(const key of ['x','y','width','height']) if(p[key]!==undefined) bounds[key]=Number(p[key])
      for(const key of ['shape','arrangement']) if(p[key]!==undefined) bounds[key]=p[key]
      if(p.points) bounds.points=JSON.parse(p.points).map(v=>Array.isArray(v)?{x:v[0],y:v[1]}:v)
      return out(await call('room.bounds',{name:p._[0],bounds}))
    }
    case 'room.layout':
      return out(await call('room.layout',{name:rest[0]}))
    case 'card.place': {
      const p=parse(rest)
      if(p.snap!==undefined&&!['on','off'].includes(p.snap))throw new Error('--snap accepts on|off');return out(await call('card.place',{id:p._[0],x:p.x,y:p.y,snap:p.snap===undefined?undefined:p.snap==='on',zoom:p.zoom===undefined?undefined:Number(p.zoom)}))
    }
    case 'canvas.view':
      return out(await call('canvas.view'))
    case 'canvas.set': {
      const p=parse(rest)
      return out(await call('canvas.set',{x:p.x,y:p.y,zoom:p.zoom}))
    }
    case 'group.rename':
      return out(await call('group.rename', { name: rest[0], nextName: rest[1] }))
    case 'group.remove':
      return out(await call('group.remove', { name: rest[0] }), (s) => s.groups.join('\n'))

    case 'card.rename':
      return out(await call('card.rename', { cardId: rest[0], title: rest.slice(1).join(' ') }))
    case 'card.clone': {const p=parse(rest);return out(await call('card.clone',{id:p._[0],title:p.title,cwd:p.cwd,directoryMode:p['directory-mode']}))}
    case 'card.create': {
      const p = parse(rest)
      return out(await call('card.create', { ...p, chatProvider:p['chat-provider'],directoryMode:p['directory-mode'],remote:remoteFlags(p), _: undefined }))
    }
    case 'card.update': {
      const p = parse(rest)
      return out(await call('card.update', { id: p._[0], patch: { ...p, chatProvider:p['chat-provider'],directoryMode:p['directory-mode'],remote:remoteFlags(p), _: undefined } }))
    }
    case 'room.design': {
      const p = parse(rest)
      const design = { theme: p.theme, wall: p.wall, desk: p.desk, subtitle: p.subtitle, background:p.background,pattern:p.pattern }
      for (const key of ['plants', 'shelf', 'lamp', 'art', 'scenery']) if (p[key] !== undefined) design[key] = p[key] === 'on'
      return out(await call('room.design', { name: p._[0] ?? '', design }))
    }
    case 'card.move': {
      const p = parse(argv.slice(1))
      return out(
        await call('card.move', { id: p._[1], group: p._[2] ?? '', before: p.before, cwd: p.cwd })
      )
    }
    case 'card.remove':
      return out(await call('card.remove', { id: rest[0] }))

    default:
      die(`unknown command: ${argv.join(' ')}\n\n${HELP}`)
  }
}

main().catch((e) => die(e.message))
