#!/usr/bin/env node
// The `agents` CLI: drives the running Agents Company app over its local
// socket. Every command maps to the same operation the GUI performs, so this
// is a faithful remote control rather than a parallel implementation.

const { connect } = require('node:net')
const { existsSync } = require('node:fs')
const { join } = require('node:path')
const { homedir } = require('node:os')

const APP_HOME = process.env.AGENTS_COMPANY_HOME || join(homedir(), 'AgentsCompany')
const SOCKET = process.env.AGENTS_COMPANY_SOCKET || require('./platform.cjs').controlEndpoint(APP_HOME)

const useJson = process.argv.includes('--json')
const argv = process.argv.slice(2).filter((a) => a !== '--json')
const parseOnly = process.env.AGENTS_COMPANY_PARSE_ONLY === '1'
let remoteInputs
function readInputFile(file) {
  if(!parseOnly)return require('node:fs').readFileSync(file,'utf8')
  remoteInputs??=JSON.parse(require('node:fs').readFileSync(0,'utf8'))
  if(!Object.prototype.hasOwnProperty.call(remoteInputs,file)||typeof remoteInputs[file]!=='string')throw new Error('Remote input file was not supplied by the remote CLI')
  return remoteInputs[file]
}

function die(msg,code) {
  if (useJson) console.log(JSON.stringify({ ok: false, error: msg, ...(code?{code}:{}) }))
  else console.error(`error: ${msg}`)
  process.exit(1)
}

/** Parse `--flag value` pairs and positional args. */
function parse(args) {
  const out = { _: [] }
  for (let i = 0; i < args.length; i++) {
    const a = args[i]
    if (a.startsWith('--')) {
      const key = a.slice(2)
      const next = args[i + 1]
      if (next === undefined || next.startsWith('--')) out[key] = true
      else {
        out[key] = next
        i++
      }
    } else out._.push(a)
  }
  return out
}

function remoteFlags(p) {
  if(p.local)return null
  if(!p['remote-host']&&!p['remote-dir'])return undefined
  return {host:p['remote-host'],directory:p['remote-dir'],os:p['remote-os']||'linux',distribution:p['remote-distribution'],port:p['ssh-port'],identityFile:p['ssh-key'],knownHosts:p['known-hosts'],sshConfig:p['ssh-config'],jump:p['ssh-jump']}
}

function jsonArgument(value) {
  if (!value || typeof value !== 'string') throw new Error('Expected JSON or @file')
  return JSON.parse(value.startsWith('@') ? readInputFile(value.slice(1)) : value)
}
function scheduleSpec(p) {
  if (p.spec) return jsonArgument(p.spec)
  const timezone = p.timezone || Intl.DateTimeFormat().resolvedOptions().timeZone
  if ([p.at, p['every-seconds'], p.time].filter(v => v !== undefined).length !== 1) throw new Error('Choose one: --at, --every-seconds, --time')
  if (p.thinking !== undefined && !['on','off'].includes(p.thinking)) throw new Error('--thinking must be on|off')
  const rule = p.at ? { kind: 'once', at: p.at }
    : p.time ? { kind: 'weekly', time: p.time, timezone, days: (p.days || '1,2,3,4,5,6,7').split(',').map(Number) }
    : { kind: 'interval', everySeconds: Number(p['every-seconds']), anchor: p.start || new Date(Date.now() + Number(p['every-seconds']) * 1000).toISOString() }
  let window
  if (p.window) {
    if (typeof p.window !== 'string' || !/^\d{2}:\d{2}-\d{2}:\d{2}$/.test(p.window)) throw new Error('--window must be HH:mm-HH:mm')
    const [start,end] = p.window.split('-')
    window = { start,end,timezone,days:p['window-days']?.split(',').map(Number) }
  }
  return { name:p.name,action:{type:'agent',employeeId:p.employee,prompt:p['prompt-file']?readInputFile(p['prompt-file']):p.prompt,viewId:p.view,model:p.model,effort:p.effort,thinking:p.thinking===undefined?undefined:p.thinking==='on'},rule,window,until:p.until,
    timeoutSeconds:p.timeout===undefined?undefined:Number(p.timeout),graceSeconds:p.grace===undefined?undefined:Number(p.grace),enabled:!p.paused,source:p.source }
}

function send(req, { stream = false } = {}) {
  if(parseOnly){process.stdout.write(JSON.stringify(req)+'\n');process.exit(0)}
  if(process.env.AGENTS_COMPANY_URL)return require('./http-client.cjs').send(req,{stream,onEvent})
  return new Promise((resolve, reject) => {
    if (process.platform!=='win32'&&!process.env.AGENTS_COMPANY_PORT&&!existsSync(SOCKET)) {
      reject(new Error('Agents Company is not running. Run `agents serve` first.'))
      return
    }
    let auth
    if(process.env.AGENTS_COMPANY_EMPLOYEE&&!process.env.AGENTS_COMPANY_TOKEN&&!process.env.AGENTS_COMPANY_TOKEN_FILE){reject(new Error('Agent identity missing; reopen this employee'));return}
    try{auth=process.env.AGENTS_COMPANY_TOKEN||require('node:fs').readFileSync(process.env.AGENTS_COMPANY_TOKEN_FILE||join(APP_HOME,'control.token'),'utf8').trim()}catch{reject(new Error('Cannot read control credential; use your assigned Agent CLI channel'));return}
    req={...req,auth}
    const sock = connect(process.env.AGENTS_COMPANY_PORT?{host:'127.0.0.1',port:Number(process.env.AGENTS_COMPANY_PORT)}:SOCKET)
    sock.setEncoding('utf8')
    let buf = ''
    let first = true
    sock.on('connect', () => sock.write(JSON.stringify(req) + '\n'))
    sock.on('data', (chunk) => {
      buf += chunk.toString()
      const lines = buf.split('\n')
      buf = lines.pop() ?? ''
      for (const line of lines) {
        if (!line.trim()) continue
        let msg
        try {
          msg = JSON.parse(line)
        } catch {
          continue
        }
        if (first) {
          first = false
          if (!msg.ok) {
            sock.end()
            reject(Object.assign(new Error(msg.error),{code:msg.code}))
            return
          }
          if (!stream) {
            sock.end()
            resolve(msg.data)
            return
          }
          resolve({ stream: sock, initial: msg.data })
        } else if (stream) {
          if (msg.type === 'event') onEvent(msg)
          else if (msg.type === 'done') sock.end()
        }
      }
    })
    sock.on('error', (e) => reject(e))
  })
}

// ---------- output helpers ----------

function table(rows, cols) {
  if (!rows.length) return '(none)'
  const widths = cols.map((c) =>
    Math.max(c.label.length, ...rows.map((r) => String(r[c.key] ?? '').length))
  )
  const head = cols.map((c, i) => c.label.padEnd(widths[i])).join('  ')
  const sep = widths.map((w) => '-'.repeat(w)).join('  ')
  const body = rows
    .map((r) => cols.map((c, i) => String(r[c.key] ?? '').padEnd(widths[i])).join('  '))
    .join('\n')
  return `${head}\n${sep}\n${body}`
}

function out(data, human) {
  if (useJson) console.log(JSON.stringify({ ok: true, data }, null, 2))
  else console.log(human ? human(data) : JSON.stringify(data, null, 2))
}

// ---------- commands ----------

const HELP = (()=>{let commands=[];try{commands=JSON.parse(require('node:fs').readFileSync(join(__dirname,'../docs/managers/commands.json'),'utf8'))}catch{}return ['agents — Agents Company authenticated CLI','','Usage: agents <command> [args] [--json]','Run agents serve for the windowless service.','Run agents auth whoami / api docs for your identity-specific API.','JSON arguments accept an inline object/array or @file.json.','',...commands.map(c=>'  '+c.name.replaceAll('.',' ')+' '+c.args+'\n      '+c.summary)].join('\n')})()

let onEvent = (m) => {
  if (useJson) console.log(JSON.stringify(m.payload))
  else if (m.channel === 'session:codex') {
    const e = m.payload.event
    if (e.kind === 'text') process.stdout.write(e.text)
    else if (e.kind === 'tool-start') console.log(`\n  $ ${e.command}`)
    else if (e.kind === 'tool-end') console.log(`  → exit ${e.exitCode}`)
  } else if (m.channel === 'session:message') {
    const msg = m.payload.message
    if (msg.type === 'assistant') {
      for (const c of msg.message?.content ?? []) {
        if (c.type === 'text') process.stdout.write(c.text)
        else if (c.type === 'tool_use') console.log(`\n  ⚙ ${c.name}`)
      }
    }
  } else if (m.channel === 'session:turn-end' || m.channel === 'session:end') {
    console.log()
  }
}

async function main() {
  const [group, sub, ...rest] = argv
  if(group==='web'&&sub==='token'){if(parseOnly||process.env.AGENTS_COMPANY_EMPLOYEE||process.env.AGENTS_COMPANY_TOKEN||process.env.AGENTS_COMPANY_TOKEN_FILE)throw Error('Only the local user can read the web access token');const token=require('node:fs').readFileSync(join(APP_HOME,'control.token'),'utf8').trim();return out({token},value=>value.token)}
  if(parseOnly&&group==='serve')throw new Error('Remote CLI cannot start a host service')
  if (!group || group === 'help' || group === '--help') {
    if(parseOnly||process.env.AGENTS_COMPANY_EMPLOYEE||process.env.AGENTS_COMPANY_TOKEN||process.env.AGENTS_COMPANY_TOKEN_FILE||process.env.AGENTS_COMPANY_PORT){
      const commands=await send({cmd:'api.list'})
      out(commands,items=>['Agents Company — 当前身份可调用的 CLI',...items.map(c=>'agents '+c.name.replaceAll('.',' ')+' '+c.args+'\n  '+c.summary),'完整角色手册：agents api docs'].join('\n'))
    }else console.log(HELP)
    return
  }

  const call = (cmd, args) => send({ cmd, args })

  if(group==='session'&&['info','snapshot','transcript','send','steer','follow','interrupt','enqueue','queue','dequeue','open'].includes(sub)&&rest.includes('--employee')){
    const p=parse(rest),result=await send({cmd:'session.'+sub,args:{employee:p.employee,viewId:p.view,text:p.text??p._.join(' '),limit:p.limit?Number(p.limit):undefined,thinking:!!p.thinking,raw:!!p.raw,messageId:p['message-id'],expectedMessageId:p['expected-message-id']}},{stream:sub==='follow'});if(sub==='follow'){if(useJson)console.log(JSON.stringify({type:'snapshot',...result.initial}));else if(result.initial.text)console.log(result.initial.text);process.on('SIGINT',()=>{result.stream.end();process.exit(0)});return}return out(result)
  }
  switch (`${group}${sub && !sub.startsWith('-') ? '.' + sub : ''}`) {
    case 'system.info': return out(await call('system.info'))
    case 'system.directories': {const p=parse(rest);return out(await call('system.directories',{path:p.path}))}
    case 'engine.list': return out(await call('engine.list'))
    case 'engine.check': {const p=parse(rest);return out(await call('engine.check',{engine:p.engine,team:p.team,force:!!p.force}))}
    case 'engine.probe': {const p=parse(rest);return out(await call('engine.probe',{engine:p.engine,model:p.model,confirm:p.confirm===true}))}
    case 'engine.configure': {const p=parse(rest);return out(await call('engine.configure',{engine:p.engine,patch:jsonArgument(p.data)}))}
    case 'engine.install-plan': case 'engine.install': case 'engine.login': {const p=parse(rest);return out(await call('engine.'+sub,{engine:p.engine,confirm:!!p.confirm}))}
    case 'engine.install-status': case 'engine.cancel-install': case 'engine.login-status': case 'engine.cancel-login': return out(await call('engine.'+sub,{id:rest[0]}))
    case 'transfer.upload-begin': {const p=parse(rest);return out(await call('transfer.upload-begin',{to:jsonArgument(p.to),name:p.name,bytes:Number(p.bytes)}))}
    case 'transfer.upload-chunk': {const p=parse(rest);return out(await call('transfer.upload-chunk',{id:p._[0],offset:Number(p.offset),data:p['data-file']?readInputFile(p['data-file']).trim():p.data}))}
    case 'transfer.upload-commit': case 'transfer.upload-abort': return out(await call('transfer.'+sub,{id:rest[0]}))
    case 'transfer.download-info': case 'transfer.download-chunk': {const p=parse(rest);return out(await call('transfer.'+sub,{from:jsonArgument(p.from),offset:Number(p.offset??0),modifiedAt:p['modified-at']===undefined?undefined:Number(p['modified-at'])}))}
    case 'schedule.schema': case 'schedule.status': return out(await call(`schedule.${sub}`))
    case 'schedule.list': { const p=parse(rest); return out(await call('schedule.list',{employee:p.employee,source:p.source})) }
    case 'schedule.get': case 'schedule.pause': case 'schedule.resume': case 'schedule.delete': case 'schedule.run': case 'schedule.cancel': return out(await call(`schedule.${sub}`,{id:rest[0]}))
    case 'schedule.create': { const p=parse(rest);return out(await call('schedule.create',{spec:scheduleSpec(p)})) }
    case 'schedule.update': { const p=parse(rest);return out(await call('schedule.update',{id:p._[0],patch:jsonArgument(p.patch)})) }
    case 'schedule.preview': { const p=parse(rest);return out(await call('schedule.preview',{id:p._[0],spec:p.spec?jsonArgument(p.spec):undefined,after:p.after,count:p.count===undefined?undefined:Number(p.count)})) }
    case 'schedule.history': { const p=parse(rest);return out(await call('schedule.history',{id:p._[0],employee:p.employee,limit:p.limit===undefined?undefined:Number(p.limit)})) }
    case 'session.rename': return out(await call('session.rename',{id:rest[0],title:rest[1]}))
    case 'shared.info': return out(await call('shared.info'))
    case 'view.shared': {if(!['on','off'].includes(rest[0]))throw Error('view shared accepts on|off');return out(await call('view.shared',{enabled:rest[0]==='on'}))}
    case 'transfer.start': {const p=parse(rest);return out(await call('transfer.start',{from:jsonArgument(p.from),to:jsonArgument(p.to)}))}
    case 'transfer.list': return out(await call('transfer.list'))
    case 'transfer.get': return out(await call('transfer.get',{id:rest[0]}))
    case 'transfer.cancel': return out(await call('transfer.cancel',{id:rest[0]}))
    case 'settings.get': return out(await call('settings.get'))
    case 'settings.set': {
      const p=parse(rest),a={};if(p.theme!==undefined)a.theme=p.theme;if(p['default-permission']!==undefined)a.defaultPermissionMode=p['default-permission'];for(const [key,flag] of [['defaultCodexModel','default-codex-model'],['defaultClaudeModel','default-claude-model'],['defaultClineModel','default-cline-model'],['defaultPiModel','default-pi-model']])if(p[flag]!==undefined)a[key]=p[flag];for(const [key,flag] of [['explorerWidth','explorer-width'],['terminalHeight','terminal-height'],['pageZoom','page-zoom'],['zoomSensitivity','zoom-sensitivity'],['panSensitivity','pan-sensitivity'],['sidebarWidth','sidebar-width']])if(p[flag]!==undefined)a[key]=Number(p[flag]);for(const [key,flag] of [['snapEmployees','snap-employees'],['showTeamOverview','team-overview']])if(p[flag]!==undefined){if(!['on','off'].includes(p[flag]))throw new Error(`--${flag} accepts on|off`);a[key]=p[flag]==='on'}return out(await call('settings.set',a))
    }
    case 'auth.whoami':case 'api.list':case 'api.docs':return out(await call(group+'.'+sub),data=>sub==='docs'?data.markdown:JSON.stringify(data,null,2))
    case 'api.describe':return out(await call('api.describe',{command:rest[0]}))
    case 'auth.agent-token':case 'auth.revoke':return out(await call('auth.'+sub,{id:rest[0]}))
    case 'connector.get':case 'connector.set':case 'connector.reset':case 'connector.segment': {const p=parse(rest),a={manager:p.manager,employee:p.employee};for(const end of ['source','target']){if(p[end+'-offset']!==undefined&&p[end]===undefined)throw Error('--'+end+'-offset requires --'+end);if(p[end]!==undefined)a[end]={side:p[end],...(p[end+'-offset']===undefined?{}:{offset:Number(p[end+'-offset'])})}}if(p.points!==undefined&&p['auto-route'])throw Error('Choose --points or --auto-route');if(p.points!==undefined)a.route=jsonArgument(p.points);if(p['auto-route'])a.route=null;if(sub==='segment'){a.index=Number(p.index);a.x=Number(p.x);a.y=Number(p.y)}return out(await call('connector.'+sub,a))}
    case 'office.layout': {const p=parse(rest);return out(await call('office.layout',{team:p.team,viewId:p.view}))}
    case 'session.acknowledge': {const p=parse(rest);return out(await call('session.acknowledge',{employee:p.employee??p._[0],replyId:p['reply-id']}))}
    case 'management.relayout': {const p=parse(rest);return out(await call('management.relayout',{team:p.team}))}
    case 'management.topology':{const p=parse(rest);return out(await call('management.topology',{team:p.team,creator:p.creator,teamsOnly:p['teams-only']===true}))}
    case 'management.activity':{const p=parse(rest);return out(await call('management.activity',{team:p.team}))}
    case 'management.roles':return out(await call('management.roles'))
    case 'management.request':{const p=parse(rest);return out(await call('management.request',{employee:p.employee,manager:p.manager}))}
    case 'management.decide':return out(await call('management.decide',{id:rest[0],decision:rest[1]}))
    case 'management.unbind':return out(await call('management.unbind',{id:rest[0]}))
    case 'management.team': {const p=parse(rest);if(p.clear&&p.team)throw Error('Use --team or --clear');return out(await call('management.team',{team:p.team,clear:!!p.clear}))}
    case 'management.global':if(!['on','off'].includes(rest[1]))throw Error('Use on or off');return out(await call('management.global',{id:rest[0],enabled:rest[1]==='on'}))
    case 'card.management-role':return out(await call('card.management-role',{id:rest[0],role:rest[1]}))
    case 'card.access-mode':return out(await call('card.access-mode',{id:rest[0],mode:rest[1]}))
    case 'session.status':{const p=parse(rest);return out(await call('session.status',{employee:p.employee}))}
    case 'view.get':case 'view.close': return out(await call(`view.${sub}`))
    case 'team-view.list': return out(await call('team-view.list'))
    case 'team-view.create': {const p=parse(rest);return out(await call('team-view.create',{name:p.name,teams:p.teams?jsonArgument(p.teams):[]}))}
    case 'team-view.update': {const p=parse(rest);return out(await call('team-view.update',{id:p._[0],patch:jsonArgument(p.patch)}))}
    case 'team-view.remove':case 'team-view.select': return out(await call(`team-view.${sub}`,{id:rest[0]}))
    case 'view.open': {
      const p=parse(rest);return out(await call('view.open',{kind:p._[0],name:p.name,employee:p.employee,pluginId:p.plugin,settings:p.mode?{mode:p.mode,pluginId:p.plugin,remote:remoteFlags(p)}:undefined,details:!!p.details}))
    }
    case 'view.details': return out(await call('view.details',{enabled:rest[0]==='on'}))
    case 'remote.check': {const p=parse(rest);return out(await call('remote.check',{employee:p.employee,team:p.team,remote:remoteFlags(p)}))}
    case 'terminal.open': {const p=parse(rest);return out(await call('terminal.open',{employee:p.employee,cols:p.cols?Number(p.cols):undefined,rows:p.rows?Number(p.rows):undefined}))}
    case 'terminal.list': {const p=parse(rest);return out(await call('terminal.list',{employee:p.employee}))}
    case 'terminal.read': {const p=parse(rest);return out(await call('terminal.read',{id:p._[0],cursor:Number(p.cursor??0)}),r=>r.output)}
    case 'terminal.input': {const p=parse(rest),data=p.file?readInputFile(p.file):p.data??p._[1]??'';return out(await call('terminal.input',{id:p._[0],data:data+(p.enter?'\r':'')}))}
    case 'terminal.resize': {const p=parse(rest);return out(await call('terminal.resize',{id:p._[0],cols:Number(p.cols),rows:Number(p.rows)}))}
    case 'terminal.close': return out(await call('terminal.close',{id:rest[0]}))
    case 'workspace.suggest':case 'workspace.choose': {
      const p=parse(rest);return out(await call(`workspace.${sub}`,{team:p.team,path:p.path,workEnvironment:p['work-environment'],mode:p.mode,pluginId:p.plugin,remote:remoteFlags(p)}))
    }
    case 'workspace.image':case 'workspace.list':case 'workspace.read':case 'workspace.write':case 'workspace.mkdir':case 'workspace.move':case 'workspace.trash':case 'workspace.restore': {
      const p=parse(rest),content=p.file?readInputFile(p.file):p.content
      return out(await call(`workspace.${sub}`,{shared:!!p.shared,team:p.team,employee:p.employee,path:p._[0]??p.path,to:p.to,content,contentBase64:p['base64-file']?readInputFile(p['base64-file']).trim():p['content-base64'],hash:p.hash,create:!!p.create,hidden:!!p.hidden,id:p.id}))
    }
    case 'serve': {
      const p=parse(argv.slice(1));if(p.web)process.env.AGENTS_COMPANY_WEB='1';for(const [flag,key] of [['host','HOST'],['port','PORT'],['public-url','PUBLIC_URL']])if(p[flag]!==undefined)process.env['AGENTS_COMPANY_WEB_'+key]=p[flag];if(p['allow-insecure'])process.env.AGENTS_COMPANY_WEB_ALLOW_INSECURE='1';
      require(join(__dirname, '..', 'out', 'main', 'daemon.js'))
    }
      return
    case 'plugin.list':
      return out(await call('plugin.list'))
    case 'plugin.describe':
      return out(await call('plugin.describe',{id:rest[0]}))
    case 'plugin.install':
      return out(await call('plugin.install',{path:rest[0]}))
    case 'plugin.call': {
      const p=parse(rest)
      const params=p.params ? JSON.parse(String(p.params).startsWith('@')?readInputFile(String(p.params).slice(1)):String(p.params)) : {}
      return out(await call('plugin.call',{id:p._[0],method:p._[1],team:p.team,workspace:p.workspace,employee:p.employee,params,raw:p.raw===true}))
    }
    case 'plugin.windows': return out(await call('plugin.windows'))
    case 'plugin.dismiss': return out(await call('plugin.dismiss',{id:rest[0]}))
    case 'plugin.mode': return out(await call('plugin.mode',{id:rest[0],mode:rest[1]}))
    case 'plugin.place': {const p=parse(rest),bounds={};for(const key of ['x','y','width','height'])if(p[key]!==undefined)bounds[key]=Number(p[key]);return out(await call('plugin.place',{id:p._[0],bounds}))}
    case 'plugin.open': {const p=parse(rest);return out(await call('plugin.open',{id:p._[0],team:p.team,employee:p.employee,workspace:p.workspace}))}
    case 'plugin.view': {
      const p=parse(rest)
      return out(await call('plugin.view',{id:p._[0],team:p.team,workspace:p.workspace,employee:p.employee}))
    }
    case 'plugin.close':
      return out(await call('plugin.close',{viewId:rest[0]}))
    case 'workspace.docs': {
      const p=parse(rest)
      return out(await call('workspace.docs',{team:p.team,workspace:p.workspace,employee:p.employee}))
    }
    case 'status':
      return out(await call('status'), (d) =>
        `running   ${d.running}\nhome      ${d.home}\nteamRoots ${Object.keys(d.teamRoots ?? {}).length}\nlive      ${d.live}\nstored    ${d.stored}`
      )

    case 'session.list': {
      const p = parse(argv.slice(1))
      const d = await call('session.list', { live: !!p.live })
      if (p.live)
        return out(d, (rows) =>
          table(rows, [
            { key: 'id', label: 'ID' },
            { key: 'engine', label: 'ENGINE' },
            { key: 'busy', label: 'BUSY' }
          ])
        )
      return out(d, (s) =>
        table(s.sessions, [
          { key: 'id', label: 'ID' },
          { key: 'engine', label: 'ENGINE' },
          { key: 'group', label: 'DEPARTMENT' },
          { key: 'title', label: 'TITLE' }
        ]) + `\n\ndepartments: ${s.groups.join(', ') || '(none)'}`
      )
    }

    case 'session.new': {
      const p = parse(argv.slice(1))
      const d = await call('session.new', {
        engine: p.engine,
        group: p.group,
        model: p.model,workEnvironment:p['work-environment'],
        cwd: p.cwd,
        directoryMode:p['directory-mode'],hostId:p['host-id'],directory:p['remote-dir'],remote:remoteFlags(p),
        title: p.title,
        seat: p.seat,
        permissionMode: p.permission,
        effort: p.effort,
        thinking: p.thinking === undefined ? undefined : p.thinking === 'on'
      })
      return out(d, (x) => `${x.sessionId}  ${x.engine}  ${x.cwd}`)
    }

    case 'session.open':
      return out(await call('session.open', { cardId: rest[0] }), (x) => `${x.sessionId}  open`)

    case 'session.activity': return out(await call('session.activity',{id:rest[0]}))
    case 'session.snapshot':
      return out(await call('session.snapshot', { id: rest[0] }))
    case 'session.search':
      return out(await call('session.search', { query: rest.join(' ') }))
    case 'approval.list':
      return out(await call('approval.list', { id: rest[0] }))
    case 'approval.respond': {const p=parse(rest);return out(await call('approval.respond',{id:p._[0],requestId:p._[1],decision:p._[2],answers:p.answers?JSON.parse(p.answers):undefined,form:p.form?JSON.parse(p.form):undefined}))}

    case 'session.send': {const parts=rest.slice(1),at=parts.indexOf('--images');let images;if(at>=0){images=JSON.parse(parts[at+1]);parts.splice(at,2)}const viewAt=parts.indexOf('--view');let viewId;if(viewAt>=0){viewId=parts[viewAt+1];if(!viewId)throw Error('--view requires a view ID');parts.splice(viewAt,2)}return out(await call('session.send',{id:rest[0],text:parts.join(' '),images,viewId}))}
    case 'session.transcript': {
      const p = parse(argv.slice(1))
      return out(await call('session.transcript', { id: p._[1] ?? rest[0], thinking: !!p.thinking }), (d) => d.text)
    }

    case 'session.info':
      return out(await call('session.info', { id: rest[0] }), (d) =>
        [
          `engine      ${d.engine}`,
          `model       ${d.model ?? '(default)'}`,
          `permission  ${d.permissionMode}`,
          `thinking    ${d.thinkingSupported ? (d.thinking ? 'on' : 'off') : 'n/a'}`,
          `effort      ${d.effort ?? '(default)'}`,
          `speed       ${d.fastMode ? 'Fast' : 'Standard'}`,
          `busy        ${d.busy}`,
          `models      ${d.models.map((m) => m.value).join(', ') || '(none)'}`,
          `commands    ${d.commands.length} available`
        ].join('\n')
      )

    case 'session.interrupt':
      return out(await call('session.interrupt', { id: rest[0] }))
    case 'session.close':
      return out(await call('session.close', { id: rest[0] }))

    case 'session.follow': {
      const p = parse(argv.slice(1))
      const id = p._[1] ?? rest[0]
      const res = await send({ cmd: 'session.follow', args: { id, raw: !!p.raw } }, { stream: true })
      if (useJson) console.log(JSON.stringify({ type: 'snapshot', ...res.initial }))
      else if (res.initial.text) console.log(res.initial.text)
      // The server ends the stream on completion, failure, or close.
      process.on('SIGINT', () => {
        res.stream.end()
        process.exit(0)
      })
      return
    }

    // Compatibility error only: an existing employee cannot change engines.
    case 'config.engine': return out(await call('config.engine',{id:rest[0],engine:rest[1]}))
    case 'config.model':
      return out(await call('config.model', { id: rest[0], model: rest[1] }))
    case 'config.remote-admin': {if(!['on','off'].includes(rest[1]))throw new Error('Use on|off');return out(await call('config.remote-admin',{id:rest[0],enabled:rest[1]==='on'}))}
    case 'config.permission':
      return out(await call('config.permission', { id: rest[0], mode: rest[1] }))
    case 'config.thinking':
      return out(await call('config.thinking', { id: rest[0], enabled: rest[1] }))
    case 'config.effort':
      // 'default' clears the override, like the Default entry in the GUI menu.
      return out(await call('config.effort', { id: rest[0], effort: rest[1] ?? 'default' }))

    case 'config.plan': {if(!['on','off'].includes(rest[1]))throw new Error('Use on|off');return out(await call('config.plan',{id:rest[0],enabled:rest[1]==='on'}))}
    case 'external.open': return out(await call('external.open',{url:rest[0]}))
    case 'engine.inspect': return out(await call('engine.inspect',{id:rest[0],section:rest[1]}))
    case 'engine.models': {const p=parse(rest);return out(await call('engine.models',{engine:p.engine,kind:p.kind,team:p.team}))}
    case 'engine.skill': return out(await call('engine.skill',{id:rest[0],name:rest[1],prompt:rest.slice(2).join(' ')}))
    case 'session.steer': return out(await call('session.steer',{id:rest[0],text:rest.slice(1).join(' ')}))
    case 'session.background': return out(await call('session.background',{id:rest[0]}))
    case 'session.background-stop': {const p=parse(rest);return out(await call('session.background-stop',{id:p._[0],processId:p.process}))}
    case 'session.review': {const p=parse(rest);return out(await call('session.review',{id:p._[0],base:p.base,commit:p.commit,instructions:p.instructions}))}
    case 'session.enqueue': {const parts=rest.slice(1),at=parts.indexOf('--images');let images;if(at>=0){images=JSON.parse(parts[at+1]);parts.splice(at,2)}const viewAt=parts.indexOf('--view');let viewId;if(viewAt>=0){viewId=parts[viewAt+1];if(!viewId)throw Error('--view requires a view ID');parts.splice(viewAt,2)}return out(await call('session.enqueue',{id:rest[0],text:parts.join(' '),images,viewId}))}
    case 'session.queue': return out(await call('session.queue',{id:rest[0]}))
    case 'session.dequeue': return out(await call('session.dequeue',{id:rest[0],messageId:rest[1]}))
    case 'session.export': {const p=parse(rest);return out(await call('session.export',{id:p._[0],format:p.format,path:p.path}),d=>d.content??JSON.stringify(d))}
    case 'view.tools': return out(await call('view.tools',{section:rest[0]==='off'?null:rest[0]}))
    case 'config.fast': {if(!['on','off'].includes(rest[1]))throw new Error('Use on|off');return out(await call('config.fast',{id:rest[0],enabled:rest[1]==='on'}))}
    case 'commands.run': return out(await call('commands.run',{id:rest[0],text:rest.slice(1).join(' ')}))
    case 'commands.list': {
      const p = parse(argv.slice(1))
      const id = p._[1] ?? rest[0]
      const rows = await call('commands.list', { id, filter: p.filter, all: !!p.all })
      return out(rows, (r) =>
        r.length
          ? r.map((c) => `/${c.name}${c.argumentHint ? ' ' + c.argumentHint : ''}  —  ${c.description}`).join('\n')
          : '(no matching commands)'
      )
    }

    case 'commands.complete': {
      const p = parse(argv.slice(1))
      const id = p._[1] ?? rest[0]
      const name = p._[2] ?? rest[1]
      return out(await call('commands.complete', { id, name }), (d) => d.completion)
    }

    case 'ui.style': {
      const p = parse(argv.slice(1))
      const sel = p._[1] ?? rest[0]
      return out(await call('ui.style', { selector: sel }), (d) =>
        Object.entries(d)
          .map(([k, v]) => `${k.padEnd(10)} ${v}`)
          .join('\n')
      )
    }

    case 'ui.screenshot':
      return out(await call('ui.screenshot', { path: rest[0],privacy:!!parse(rest).privacy }))
    case 'ui.drag':
    case 'ui.wheel': {
      const p=parse(rest)
      return out(await call(`ui.${sub}`,{selector:p._[0],dx:Number(p.dx??0),dy:Number(p.dy??0),zoom:!!p.zoom}))
    }

    case 'ui.view':
      return out(await call('ui.view'), (d) => {
        const lines = [`view        ${d.view}`]
        if (d.view === 'home') {
          lines.push(`departments ${d.departments.join(', ') || '(none)'}`)
          lines.push(`cards       ${d.cards.length}`)
          for (const c of d.cards) lines.push(`  · ${c.title}  [${c.engine}]  ${c.group || 'Unassigned'}`)
        } else if (d.session) {
          const s = d.session
          lines.push(`session     ${s.title}`)
          lines.push(`engine      ${s.engine}`)
          lines.push(`model       ${s.model}`)
          lines.push(`permission  ${s.permission}`)
          lines.push(`thinking    ${s.thinking}`)
          lines.push(`busy        ${s.busy}`)
          lines.push(`turns       ${s.turns}`)
          lines.push(`back button ${s.hasBackButton ? 'yes' : 'NO'}`)
        }
        return lines.join('\n')
      })

    case 'ui.text':
      return out(await call('ui.text'), (d) => String(d))

    case 'ui.dom': {
      const p = parse(argv.slice(1))
      const sel = p.sel || p.selector || 'body'
      return out(await call('ui.dom', { selector: sel }), (rows) =>
        rows.map((r) => `${r.visible ? '●' : '○'} ${r.tag}.${String(r.cls).split(' ')[0]}  ${r.text.slice(0, 70)}`).join('\n')
      )
    }

    case 'ui.click':
      return out(await call('ui.click', { selector: rest[0] }), (d) => `clicked ${d.clicked ?? rest[0]}`)

    case 'ui.type':
      return out(await call('ui.type', { selector: rest[0], value: rest.slice(1).join(' ') }))

    case 'ui.wait': {
      const p = parse(argv.slice(1))
      // argv is ['ui','wait','<selector>'], so the selector is the second positional.
      const sel = p._[1] ?? p._[0]
      return out(await call('ui.wait', { selector: sel, timeout: p.timeout }), (d) =>
        d.found ? 'found' : 'not found'
      )
    }

    case 'room.place': {
      const p = parse(argv.slice(1))
      const name = p._[1] ?? p._[0]
      return out(
        await call('room.place', {
          name,
          col: p.col,
          row: p.row,
          w: p.w ?? 1,
          h: p.h ?? 1
        }),
        (s) => JSON.stringify(s.rooms?.[name] ?? null)
      )
    }

    case 'group.list':
      {const p=parse(rest);return out(await call('group.list',{details:!!p.details}),g=>g.map(value=>typeof value==='string'?value:`${value.name} · ${value.mode}${value.remote?' · '+value.remote.host:value.pluginId?' · '+value.pluginId:''} · ${value.root??''}`).join('\n')||'(none)')}
    case 'host.terminal-open': case 'host.terminal-list': case 'host.terminal-read': case 'host.terminal-input': case 'host.terminal-resize': case 'host.terminal-close':
    case 'host.desktop-open': case 'host.desktop-list': case 'host.desktop-launch': case 'host.desktop-close': {
      const p=parse(rest),a={id:p._[0],terminal:p.terminal,session:p.session,directory:p.directory}
      for(const key of ['cols','rows','cursor'])if(p[key]!==undefined)a[key]=Number(p[key])
      if(p['wait-ms']!==undefined)a.waitMs=Number(p['wait-ms'])
      if(sub==='terminal-input')a.data=(p.file?readInputFile(p.file):p.data??'')+(p.enter?'\r':'')
      return out(await call('host.'+sub,a))
    }
    case 'host.exec': {const p=parse(rest);return out(await call('host.exec',{id:p._[0],directory:p.directory,command:p['command-file']?readInputFile(p['command-file']):p.command,timeout:p.timeout?Number(p.timeout):undefined}))}
    case 'host.list': {const p=parse(rest);return out(await call('host.list',{os:p.os,distribution:p.distribution,summary:!!p.summary,credentials:!!p.credentials}))}
    case 'host.fingerprints': case 'host.get': case 'host.remove': case 'host.check': case 'host.credentials': return out(await call(`host.${sub}`,{id:rest[0]}))
    case 'host.trust': {const p=parse(rest);return out(await call('host.trust',{id:p._[0],fingerprint:p.fingerprint}))}
    case 'host.create': {const p=parse(rest);return out(await call('host.create',jsonArgument(p.data||'{}')))}
    case 'host.update': {const p=parse(rest);return out(await call('host.update',{id:p._[0],patch:jsonArgument(p.data||'{}')}))}
    case 'host.directories': {const p=parse(rest);return out(await call('host.directories',{id:p._[0],path:p.path}))}
    case 'engine.remote-check': {const p=parse(rest);return out(await call('engine.remote-check',{team:p.team,engine:p.engine,directory:p.directory}))}
    case 'engine.remote-sessions': {const p=parse(rest);return out(await call('engine.remote-sessions',{team:p.team,engine:p.engine}))}
    case 'group.add':
      {const p=parse(rest);return out(await call('group.add', { name: rest[0], root:p.root,mode:p.mode,pluginId:p.plugin,directoryMode:p['directory-mode'],hostId:p['host-id'],directory:p['remote-dir'],remote:remoteFlags(p),os:p.os,distribution:p.distribution }), (s) => s.groups.join('\n'))}
    case 'group.configure':
      {const p=parse(rest);return out(await call('group.configure',{name:p._[0],mode:p.mode,pluginId:p.plugin,directoryMode:p['directory-mode'],root:p.root,hostId:p['host-id'],directory:p['remote-dir'],remote:remoteFlags(p)}))}
    case 'group.migrate': return out(await call('group.migrate',{name:rest[0]}))
    case 'group.root':
      return out(await call('group.root',{name:rest[0],root:rest[1],create:!!parse(rest).create,directoryMode:parse(rest)['directory-mode']}))
    case 'room.bounds': {
      const p=parse(rest), bounds={}
      for(const key of ['x','y','width','height']) if(p[key]!==undefined) bounds[key]=Number(p[key])
      for(const key of ['shape','arrangement']) if(p[key]!==undefined) bounds[key]=p[key]
      if(p.points) bounds.points=JSON.parse(p.points).map(v=>Array.isArray(v)?{x:v[0],y:v[1]}:v)
      return out(await call('room.bounds',{name:p._[0],bounds}))
    }
    case 'room.layout':
      return out(await call('room.layout',{name:rest[0]}))
    case 'card.place': {
      const p=parse(rest)
      if(p.snap!==undefined&&!['on','off'].includes(p.snap))throw new Error('--snap accepts on|off');return out(await call('card.place',{id:p._[0],x:p.x,y:p.y,snap:p.snap===undefined?undefined:p.snap==='on',zoom:p.zoom===undefined?undefined:Number(p.zoom)}))
    }
    case 'canvas.view':
      return out(await call('canvas.view',{viewId:parse(rest).view}))
    case 'canvas.set': {
      const p=parse(rest)
      return out(await call('canvas.set',{x:p.x,y:p.y,zoom:p.zoom,viewId:p.view}))
    }
    case 'group.rename':
      return out(await call('group.rename', { name: rest[0], nextName: rest[1] }))
    case 'group.remove':
      {const p=parse(rest);if(p['delete-workspace']!==undefined&&p['delete-workspace']!==true)throw Error('--delete-workspace is a flag');return out(await call('group.remove', { ...(p._.length===1?{name:p._[0]}:{names:p._}),deleteWorkspace:p['delete-workspace']===true }), (s) => s.groups.join('\n'))}

    case 'card.rename':
      return out(await call('card.rename', { cardId: rest[0], title: rest.slice(1).join(' ') }))
    case 'card.clone': {const p=parse(rest);return out(await call('card.clone',{id:p._[0],title:p.title,cwd:p.cwd,directoryMode:p['directory-mode']}))}
    case 'card.initialize': {const p=parse(rest);return out(await call('card.initialize',{id:p._[0],model:p.model,effort:p.effort}))}
    case 'card.native-bind':return out(await call('card.native-bind',{id:rest[0],sessionId:rest[1]}))
    case 'card.create': {
      const p = parse(rest)
      if(p.kind!==undefined&&!['worker','cloud-native-worker'].includes(p.kind)||p['chat-provider']!==undefined||p['chat-mode']!==undefined||p['chrome-profile']!==undefined)throw new Error('Only Local or Cloud Native Worker employees are supported')
      return out(await call('card.create', { ...p, permissionMode:p.permission, workEnvironment:p['work-environment'],managementRole:p['management-role'],accessMode:p['access-mode'],directoryMode:p['directory-mode'],hostId:p['host-id'],directory:p['remote-dir'],remote:remoteFlags(p), _: undefined }))
    }
    case 'card.update': {
      const p = parse(rest)
      if(p.kind!==undefined&&!['worker','cloud-native-worker'].includes(p.kind)||p['chat-provider']!==undefined||p['chat-mode']!==undefined||p['chrome-profile']!==undefined)throw new Error('Only Local or Cloud Native Worker employees are supported')
      return out(await call('card.update', { id: p._[0], patch: { ...p, workEnvironment:p['work-environment'],directoryMode:p['directory-mode'],hostId:p['host-id'],directory:p['remote-dir'],remote:remoteFlags(p), _: undefined } }))
    }
    case 'room.design': {
      const p = parse(rest)
      const design = { theme: p.theme, wall: p.wall, desk: p.desk, subtitle: p.subtitle, background:p.background,pattern:p.pattern }
      for (const key of ['plants', 'shelf', 'lamp', 'art', 'scenery']) if (p[key] !== undefined) design[key] = p[key] === 'on'
      return out(await call('room.design', { name: p._[0] ?? '', design }))
    }
    case 'card.move': {
      const p = parse(argv.slice(1))
      return out(
        await call('card.move', { id: p._[1], group: p._[2] ?? '', before: p.before, cwd: p.cwd })
      )
    }
    case 'card.remove':
      {const p=parse(rest);if(p['delete-workspace']!==undefined&&p['delete-workspace']!==true)throw Error('--delete-workspace is a flag');return out(await call('card.remove', { ...(p._.length===1?{id:p._[0]}:{ids:p._}),deleteWorkspace:p['delete-workspace']===true }))}

    default:
      die(`unknown command: ${argv.join(' ')}\n\n${HELP}`)
  }
}

main().catch((e) => die(e.message,e.code))
