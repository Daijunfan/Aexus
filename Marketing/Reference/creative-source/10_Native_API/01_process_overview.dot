digraph Avalon {graph [rankdir=TB,bgcolor="transparent",pad=.2,ranksep=0.28,nodesep=0.26,splines=ortho,outputorder=edgesfirst];node [fontname="Hiragino Sans GB",fontcolor="#111b22",style="filled",fillcolor="white"];edge [fontname="Hiragino Sans GB",fontsize=13,color="#3b4b53",penwidth=1.9,arrowsize=.68];L0 [shape=plaintext,fontname="Menlo",fontsize=12,fontcolor="#88959e",label="01 / 发现能力"];L1 [shape=plaintext,fontname="Menlo",fontsize=12,fontcolor="#88959e",label="02 / 确定目标"];L2 [shape=plaintext,fontname="Menlo",fontsize=12,fontcolor="#88959e",label="03 / 发出调用"];L3 [shape=plaintext,fontname="Menlo",fontsize=12,fontcolor="#88959e",label="04 / 权限校验"];L4 [shape=plaintext,fontname="Menlo",fontsize=12,fontcolor="#88959e",label="05 / 业务执行"];L5 [shape=plaintext,fontname="Menlo",fontsize=12,fontcolor="#88959e",label="06 / 回查结果"];A [shape=box,width=3.45,height=.62,color="#3b4b53",fillcolor="white",label=<<B><FONT POINT-SIZE="17">目标与范围</FONT></B><BR/><FONT POINT-SIZE="12">api.list / api.describe · 读取命令与合法参数</FONT>>,penwidth=2,margin=".12,.09"];B [shape=box,width=3.45,height=.62,color="#3b4b53",fillcolor="white",label=<<B><FONT POINT-SIZE="17">材料与入口</FONT></B><BR/><FONT POINT-SIZE="12">plan.query / schedule.get · 获取真实 ID、配置与修订</FONT>>,penwidth=2,margin=".12,.09"];C [shape=box,width=5.4,height=.62,color="#0659c4",fillcolor="white",label=<<B><FONT POINT-SIZE="17">确定目标</FONT></B><BR/><FONT POINT-SIZE="12">使用真实 Team、员工、频道和任务 ID。</FONT>>,penwidth=2,margin=".12,.09"];R0 [shape=box,width=2.65,height=.62,color="#0659c4",fillcolor="white",label=<<B><FONT POINT-SIZE="17">文档工具</FONT></B><BR/><FONT POINT-SIZE="12">发现当前命令与参数 · 清楚的操作契约</FONT>>,penwidth=2,margin=".12,.09"];R1 [shape=box,width=2.65,height=.62,color="#0659c4",fillcolor="white",label=<<B><FONT POINT-SIZE="17">原生 API 工具</FONT></B><BR/><FONT POINT-SIZE="12">以员工身份执行命令 · 实际操作结果</FONT>>,penwidth=2,margin=".12,.09"];R2 [shape=box,width=2.65,height=.62,color="#0659c4",fillcolor="white",label=<<B><FONT POINT-SIZE="17">Core</FONT></B><BR/><FONT POINT-SIZE="12">处理身份、权限与业务 · 同一套规则</FONT>>,penwidth=2,margin=".12,.09"];D [shape=box,width=3.45,height=.62,color="#0659c4",fillcolor="white",label=<<B><FONT POINT-SIZE="17">权限校验</FONT></B><BR/><FONT POINT-SIZE="12">以调用员工本人的身份检查范围。</FONT>>,penwidth=2,margin=".12,.09"];F [shape=box,width=3.45,height=.62,color="#8a9c16",fillcolor="white",label=<<B><FONT POINT-SIZE="17">工作记录与文件</FONT></B><BR/><FONT POINT-SIZE="12">operation-plan.md · 本次对象、命令与预期效果</FONT>>,penwidth=2,margin=".12,.09"];G [shape=box,width=3.45,height=.62,color="#0659c4",fillcolor="white",label=<<B><FONT POINT-SIZE="17">业务执行</FONT></B><BR/><FONT POINT-SIZE="12">界面、CLI 和原生工具复用同一实现。</FONT>>,penwidth=2,margin=".12,.09"];H [shape=box,width=3.45,height=.62,color="#bd4234",fillcolor="white",label=<<B><FONT POINT-SIZE="17">检查与交接</FONT></B><BR/><FONT POINT-SIZE="12">query-results.json · 真实目标、状态与可用动作</FONT>>,penwidth=2,margin=".12,.09"];O [shape=box,width=3.45,height=.62,color="#1c7045",fillcolor="white",label=<<B><FONT POINT-SIZE="17">接口完整</FONT></B><BR/><FONT POINT-SIZE="12">公开 Core 业务能力可被发现</FONT>>,penwidth=2,margin=".12,.09"];N [shape=box,width=3.45,height=.62,color="#1c7045",fillcolor="white",label=<<B><FONT POINT-SIZE="17">回查结果</FONT></B><BR/><FONT POINT-SIZE="12">读取状态、记录与具体产物。</FONT>>,penwidth=2,margin=".12,.09"];{rank=same;L0;A;B;}{rank=same;L1;C;}{rank=same;L2;R0;R1;R2;}{rank=same;L3;D;F;}{rank=same;L4;G;H;}{rank=same;L5;O;N;}L0->A [style=invis];L1->C [style=invis];L2->R0 [style=invis];L3->D [style=invis];L4->G [style=invis];L5->O [style=invis];L0->L1->L2->L3->L4->L5 [style=invis,weight=40];A->C;B->C;C->R0;C->R1;C->R2;R0->D;R1->D;R2->D;D->F;D->G;F->H;G->O;H->N;}