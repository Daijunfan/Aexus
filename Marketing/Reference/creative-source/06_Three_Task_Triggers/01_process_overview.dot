digraph Avalon {graph [rankdir=TB,bgcolor="transparent",pad=.2,ranksep=0.28,nodesep=0.26,splines=ortho,outputorder=edgesfirst];node [fontname="Hiragino Sans GB",fontcolor="#111b22",style="filled",fillcolor="white"];edge [fontname="Hiragino Sans GB",fontsize=13,color="#3b4b53",penwidth=1.9,arrowsize=.68];L0 [shape=plaintext,fontname="Menlo",fontsize=12,fontcolor="#88959e",label="01 / 确定任务"];L1 [shape=plaintext,fontname="Menlo",fontsize=12,fontcolor="#88959e",label="02 / 选择员工"];L2 [shape=plaintext,fontname="Menlo",fontsize=12,fontcolor="#88959e",label="03 / 设置规则"];L3 [shape=plaintext,fontname="Menlo",fontsize=12,fontcolor="#88959e",label="04 / 查看 Plan"];L4 [shape=plaintext,fontname="Menlo",fontsize=12,fontcolor="#88959e",label="05 / 实际执行"];L5 [shape=plaintext,fontname="Menlo",fontsize=12,fontcolor="#88959e",label="06 / 查看结果"];A [shape=box,width=3.45,height=.62,color="#3b4b53",fillcolor="white",label=<<B><FONT POINT-SIZE="17">目标与范围</FONT></B><BR/><FONT POINT-SIZE="12">指定时刻 · 适合临时整理、检查或汇总</FONT>>,penwidth=2,margin=".12,.09"];B [shape=box,width=3.45,height=.62,color="#3b4b53",fillcolor="white",label=<<B><FONT POINT-SIZE="17">材料与入口</FONT></B><BR/><FONT POINT-SIZE="12">间隔 / 周 / 月 · 适合规律性工作，保留时区</FONT>>,penwidth=2,margin=".12,.09"];C [shape=box,width=5.4,height=.62,color="#0659c4",fillcolor="white",label=<<B><FONT POINT-SIZE="17">选择员工</FONT></B><BR/><FONT POINT-SIZE="12">由合适员工承担执行。</FONT>>,penwidth=2,margin=".12,.09"];R0 [shape=box,width=2.65,height=.62,color="#0659c4",fillcolor="white",label=<<B><FONT POINT-SIZE="17">一次任务</FONT></B><BR/><FONT POINT-SIZE="12">在指定时刻做一件事 · 临时整理或检查</FONT>>,penwidth=2,margin=".12,.09"];R1 [shape=box,width=2.65,height=.62,color="#0659c4",fillcolor="white",label=<<B><FONT POINT-SIZE="17">重复任务</FONT></B><BR/><FONT POINT-SIZE="12">按周、月或间隔继续 · 周期性工作</FONT>>,penwidth=2,margin=".12,.09"];R2 [shape=box,width=2.65,height=.62,color="#0659c4",fillcolor="white",label=<<B><FONT POINT-SIZE="17">事件任务</FONT></B><BR/><FONT POINT-SIZE="12">收到指定事件再开始 · 对新内容作出响应</FONT>>,penwidth=2,margin=".12,.09"];D [shape=box,width=3.45,height=.62,color="#0659c4",fillcolor="white",label=<<B><FONT POINT-SIZE="17">查看 Plan</FONT></B><BR/><FONT POINT-SIZE="12">任务配置和状态统一管理。</FONT>>,penwidth=2,margin=".12,.09"];F [shape=box,width=3.45,height=.62,color="#8a9c16",fillcolor="white",label=<<B><FONT POINT-SIZE="17">工作记录与文件</FONT></B><BR/><FONT POINT-SIZE="12">task-brief.md · 每项任务的材料与目标</FONT>>,penwidth=2,margin=".12,.09"];G [shape=box,width=3.45,height=.62,color="#0659c4",fillcolor="white",label=<<B><FONT POINT-SIZE="17">实际执行</FONT></B><BR/><FONT POINT-SIZE="12">到时或收到合法事件后执行。</FONT>>,penwidth=2,margin=".12,.09"];H [shape=box,width=3.45,height=.62,color="#bd4234",fillcolor="white",label=<<B><FONT POINT-SIZE="17">检查与交接</FONT></B><BR/><FONT POINT-SIZE="12">run-notes.md · 执行结果、文件位置和问题</FONT>>,penwidth=2,margin=".12,.09"];O [shape=box,width=3.45,height=.62,color="#1c7045",fillcolor="white",label=<<B><FONT POINT-SIZE="17">统一计划</FONT></B><BR/><FONT POINT-SIZE="12">三类规则进入同一个 Plan</FONT>>,penwidth=2,margin=".12,.09"];N [shape=box,width=3.45,height=.62,color="#1c7045",fillcolor="white",label=<<B><FONT POINT-SIZE="17">查看结果</FONT></B><BR/><FONT POINT-SIZE="12">从执行记录和会话检查产物。</FONT>>,penwidth=2,margin=".12,.09"];{rank=same;L0;A;B;}{rank=same;L1;C;}{rank=same;L2;R0;R1;R2;}{rank=same;L3;D;F;}{rank=same;L4;G;H;}{rank=same;L5;O;N;}L0->A [style=invis];L1->C [style=invis];L2->R0 [style=invis];L3->D [style=invis];L4->G [style=invis];L5->O [style=invis];L0->L1->L2->L3->L4->L5 [style=invis,weight=40];A->C;B->C;C->R0;C->R1;C->R2;R0->D;R1->D;R2->D;D->F;D->G;F->H;G->O;H->N;}