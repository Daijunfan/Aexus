digraph Avalon {graph [rankdir=TB,bgcolor="transparent",pad=.2,ranksep=0.31,nodesep=0.28,splines=ortho,outputorder=edgesfirst];node [fontname="Hiragino Sans GB",fontcolor="#111b22",style="filled",fillcolor="white"];edge [fontname="Hiragino Sans GB",fontsize=13,color="#3b4b53",penwidth=1.9,arrowsize=.68];S [shape=ellipse,width=1.65,height=.46,label="写清任务",fontsize=14,margin=".10,.08",color="#3b4b53",penwidth=1.7];Q [shape=diamond,width=1.65,height=.46,label="选择规则",fontsize=14,margin=".10,.08",color="#0659c4",penwidth=1.7];A [shape=box,width=1.65,height=.46,label="一次\n指定时刻",fontsize=14,margin=".10,.08",color="#0659c4",penwidth=1.7];B [shape=box,width=1.65,height=.46,label="重复\n间隔 / 周 / 月",fontsize=14,margin=".10,.08",color="#0659c4",penwidth=1.7];C [shape=box,width=1.65,height=.46,label="事件\n新帖 / signal",fontsize=14,margin=".10,.08",color="#0659c4",penwidth=1.7];O [shape=box,width=3.4,height=.46,label="执行与记录",fontsize=14,margin=".10,.08",color="#1c7045",penwidth=1.7];S->Q;Q->A;Q->B;Q->C;{rank=same;A;B;C;}A->O;B->O;C->O;}