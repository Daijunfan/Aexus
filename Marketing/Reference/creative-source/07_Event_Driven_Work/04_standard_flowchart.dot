digraph Avalon {graph [rankdir=TB,bgcolor="transparent",pad=.2,ranksep=0.31,nodesep=0.28,splines=ortho,outputorder=edgesfirst];node [fontname="Hiragino Sans GB",fontcolor="#111b22",style="filled",fillcolor="white"];edge [fontname="Hiragino Sans GB",fontsize=13,color="#3b4b53",penwidth=1.9,arrowsize=.68];S [shape=parallelogram,width=1.65,height=.46,label="新帖 / 信号",fontsize=14,margin=".10,.08",color="#3b4b53",penwidth=1.7];Q [shape=diamond,width=1.65,height=.46,label="符合规则？",fontsize=14,margin=".10,.08",color="#0659c4",penwidth=1.7];P [shape=box,width=1.65,height=.46,label="处理内容",fontsize=14,margin=".10,.08",color="#0659c4",penwidth=1.7];R [shape=box,width=1.65,height=.46,label="忽略 / 跳过",fontsize=14,margin=".10,.08",color="#bd4234",penwidth=1.7];O [shape=parallelogram,width=1.65,height=.46,label="产物与记录",fontsize=14,margin=".10,.08",color="#1c7045",penwidth=1.7];S->Q;Q->P [xlabel="符合"];Q->R [xlabel="不符合",color="#bd4234"];{rank=same;P;R;}P->O;}