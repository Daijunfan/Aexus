digraph Avalon {graph [rankdir=TB,bgcolor="transparent",pad=.2,ranksep=0.31,nodesep=0.28,splines=ortho,outputorder=edgesfirst];node [fontname="Hiragino Sans GB",fontcolor="#111b22",style="filled",fillcolor="white"];edge [fontname="Hiragino Sans GB",fontsize=13,color="#3b4b53",penwidth=1.9,arrowsize=.68];S [shape=ellipse,width=1.65,height=.46,label="明确目标",fontsize=14,margin=".10,.08",color="#3b4b53",penwidth=1.7];I [shape=parallelogram,width=1.65,height=.46,label="指定材料",fontsize=14,margin=".10,.08",color="#3b4b53",penwidth=1.7];P [shape=box,width=1.65,height=.46,label="员工处理",fontsize=14,margin=".10,.08",color="#0659c4",penwidth=1.7];Q [shape=diamond,width=1.65,height=.46,label="需要修订？",fontsize=14,margin=".10,.08",color="#3b4b53",penwidth=1.7];R [shape=box,width=1.65,height=.46,label="补充要求",fontsize=14,margin=".10,.08",color="#bd4234",penwidth=1.7];O [shape=parallelogram,width=1.65,height=.46,label="保存产物",fontsize=14,margin=".10,.08",color="#1c7045",penwidth=1.7];E [shape=ellipse,width=1.65,height=.46,label="检查交接",fontsize=14,margin=".10,.08",color="#1c7045",penwidth=1.7];{rank=same;S;I;}{rank=same;P;Q;R;}{rank=same;O;E;}S->I;I->P;P->Q;Q->O [xlabel="否"];O->E;Q->R [xlabel="是",color="#bd4234"];R->P [color="#bd4234",style=dashed];}