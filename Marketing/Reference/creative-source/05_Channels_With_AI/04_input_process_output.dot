digraph Avalon {graph [rankdir=LR,bgcolor="transparent",pad=.2,ranksep=0.45,nodesep=0.55,splines=ortho,outputorder=edgesfirst];node [fontname="Hiragino Sans GB",fontcolor="#111b22",style="filled",fillcolor="white"];edge [fontname="Hiragino Sans GB",fontsize=13,color="#3b4b53",penwidth=1.9,arrowsize=.68];A [shape=parallelogram,width=3.4,height=0.88,color="#3b4b53",fillcolor="white",label=<<B><FONT POINT-SIZE="20">安排解读</FONT></B><BR/><FONT POINT-SIZE="15">INPUT / 起点</FONT>>,fontsize=19,penwidth=2.2,margin=".18,.14"];B [shape=box,width=3.4,height=0.88,color="#0659c4",fillcolor="white",label=<<B><FONT POINT-SIZE="20">发布观点</FONT></B><BR/><FONT POINT-SIZE="15">PROCESS / 工作</FONT>>,fontsize=19,penwidth=2.2,margin=".18,.14"];C [shape=parallelogram,width=3.4,height=0.88,color="#1c7045",fillcolor="white",label=<<B><FONT POINT-SIZE="20">继续追问</FONT></B><BR/><FONT POINT-SIZE="15">OUTPUT / 结果</FONT>>,fontsize=19,penwidth=2.2,margin=".18,.14"];A->B;B->C;}