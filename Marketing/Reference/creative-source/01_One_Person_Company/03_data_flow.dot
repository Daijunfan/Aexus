digraph Avalon {graph [rankdir=TB,bgcolor="transparent",pad=.2,ranksep=0.33,nodesep=0.48,splines=ortho,outputorder=edgesfirst];node [fontname="Hiragino Sans GB",fontcolor="#111b22",style="filled",fillcolor="white"];edge [fontname="Hiragino Sans GB",fontsize=13,color="#3b4b53",penwidth=1.9,arrowsize=.68];U [shape=box,width=1.7,height=.46,label="用户目标",fontsize=14,margin=".10,.08",color="#3b4b53",penwidth=1.7];M [shape=box,width=1.7,height=.46,label="指定材料",fontsize=14,margin=".10,.08",color="#3b4b53",penwidth=1.7];P [shape=circle,width=1.05,height=.46,label="1.0\n组织任务",fontsize=14,margin=".10,.08",color="#0659c4",penwidth=1.7];Q [shape=circle,width=1.05,height=.46,label="2.0\n处理内容",fontsize=14,margin=".10,.08",color="#0659c4",penwidth=1.7];D [shape=plain,label=<<TABLE BORDER="1.7" SIDES="TB" CELLBORDER="0" CELLPADDING="7" COLOR="#8a9c16"><TR><TD><FONT POINT-SIZE="14">D1 · 工作记录</FONT></TD></TR></TABLE>>];F [shape=plain,label=<<TABLE BORDER="1.7" SIDES="TB" CELLBORDER="0" CELLPADDING="7" COLOR="#1c7045"><TR><TD><FONT POINT-SIZE="14">D2 · 交付文件</FONT></TD></TR></TABLE>>];{rank=same;U;M;}{rank=same;P;Q;}{rank=same;D;F;}U->P [xlabel="目标"];M->Q [xlabel="材料"];P->D [xlabel="任务"];D->Q [xlabel="上下文"];Q->F [xlabel="产物"];}