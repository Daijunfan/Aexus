digraph Avalon {graph [rankdir=TB,bgcolor="transparent",pad=.2,ranksep=0.28,nodesep=0.26,splines=ortho,outputorder=edgesfirst];node [fontname="Hiragino Sans GB",fontcolor="#111b22",style="filled",fillcolor="white"];edge [fontname="Hiragino Sans GB",fontsize=13,color="#3b4b53",penwidth=1.9,arrowsize=.68];L0 [shape=plaintext,fontname="Menlo",fontsize=12,fontcolor="#88959e",label="01 / 打开项目"];L1 [shape=plaintext,fontname="Menlo",fontsize=12,fontcolor="#88959e",label="02 / 准备环境"];L2 [shape=plaintext,fontname="Menlo",fontsize=12,fontcolor="#88959e",label="03 / 配置引擎"];L3 [shape=plaintext,fontname="Menlo",fontsize=12,fontcolor="#88959e",label="04 / 创建秘书"];L4 [shape=plaintext,fontname="Menlo",fontsize=12,fontcolor="#88959e",label="05 / 交代小任务"];L5 [shape=plaintext,fontname="Menlo",fontsize=12,fontcolor="#88959e",label="06 / 查看三个视图"];A [shape=box,width=3.45,height=.62,color="#3b4b53",fillcolor="white",label=<<B><FONT POINT-SIZE="17">目标与范围</FONT></B><BR/><FONT POINT-SIZE="12">Mac / Windows / Linux Web · 按 README 选择实际使用入口</FONT>>,penwidth=2,margin=".12,.09"];B [shape=box,width=3.45,height=.62,color="#3b4b53",fillcolor="white",label=<<B><FONT POINT-SIZE="17">材料与入口</FONT></B><BR/><FONT POINT-SIZE="12">所需引擎与模型配置 · 先把执行方式配置清楚</FONT>>,penwidth=2,margin=".12,.09"];C [shape=box,width=5.4,height=.62,color="#0659c4",fillcolor="white",label=<<B><FONT POINT-SIZE="17">准备环境</FONT></B><BR/><FONT POINT-SIZE="12">按 README 安装或从源码启动。</FONT>>,penwidth=2,margin=".12,.09"];R0 [shape=box,width=2.65,height=.62,color="#0659c4",fillcolor="white",label=<<B><FONT POINT-SIZE="17">Company</FONT></B><BR/><FONT POINT-SIZE="12">看团队与协作关系 · 谁负责什么</FONT>>,penwidth=2,margin=".12,.09"];R1 [shape=box,width=2.65,height=.62,color="#0659c4",fillcolor="white",label=<<B><FONT POINT-SIZE="17">Messages</FONT></B><BR/><FONT POINT-SIZE="12">看会话、群组和频道 · 如何交流与交接</FONT>>,penwidth=2,margin=".12,.09"];R2 [shape=box,width=2.65,height=.62,color="#0659c4",fillcolor="white",label=<<B><FONT POINT-SIZE="17">Plan</FONT></B><BR/><FONT P