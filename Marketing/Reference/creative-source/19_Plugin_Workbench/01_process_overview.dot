digraph Avalon {graph [rankdir=TB,bgcolor="transparent",pad=.2,ranksep=0.28,nodesep=0.26,splines=ortho,outputorder=edgesfirst];node [fontname="Hiragino Sans GB",fontcolor="#111b22",style="filled",fillcolor="white"];edge [fontname="Hiragino Sans GB",fontsize=13,color="#3b4b53",penwidth=1.9,arrowsize=.68];L0 [shape=plaintext,fontname="Menlo",fontsize=12,fontcolor="#88959e",label="01 / 确定工作"];L1 [shape=plaintext,fontname="Menlo",fontsize=12,fontcolor="#88959e",label="02 / 选择插件"];L2 [shape=plaintext,fontname="Menlo",fontsize=12,fontcolor="#88959e",label="03 / 给出材料"];L3 [shape=plaintext,fontname="Menlo",fontsize=12,fontcolor="#88959e",label="04 / 员工操作"];L4 [shape=plaintext,fontname="Menlo",fontsize=12,fontcolor="#88959e",label="05 / 保存产物"];L5 [shape=plaintext,fontname="Menlo",fontsize=12,fontcolor="#88959e",label="06 / 继续协作"];A [shape=box,width=3.45,height=.62,color="#3b4b53",fillcolor="white",label=<<B><FONT POINT-SIZE="17">目标与范围</FONT></B><BR/><FONT POINT-SIZE="12">阅读 / 摘录 / 资料整理 · 接住文档与原文线索</FONT>>,penwidth=2,margin=".12,.09"];B [shape=box,width=3.45,height=.62,color="#3b4b53",fillcolor="white",label=<<B><FONT POINT-SIZE="17">材料与入口</FONT></B><BR/><FONT POINT-SIZE="12">笔记 / 数据库 / 知识组织 · 接住整理后的观点与问题</FONT>>,penwidth=2,margin=".12,.09"];C [shape=box,width=5.4,height=.62,color="#0659c4",fillcolor="white",label=<<B><FONT POINT-SIZE="17">选择插件</FONT></B><BR/><FONT POINT-SIZE="12">使用对应的阅读、笔记或主机能力。</FONT>>,penwidth=2,margin=".12,.09"];R0 [shape=box,width=2.65,height=.62,color="#0659c4",fillcolor="white",label=<<B><FONT POINT-SIZE="17">Margin Reader</FONT></B><BR/><FONT POINT-SIZE="12">文档阅读、摘录与资料整理 · 阅读线索</FONT>>,penwidth=2,margin=".12,.09"];R1 [shape=box,width=2.65,height=.62,color="#0659c4",fillcolor="white",label=<<B><FONT POINT-SIZE="17">MiniNotion</FONT></B><BR/><FONT POINT-SIZE="12">笔记、数据库与知识组织 · 结构化笔记</FONT>>,penwidth=2,margin=".12,.09"];R2 [shape=box,width=2.65,height=.62,color="#0659c4",fillcolor="white",label=<<B><FONT POINT-SIZE="17">Cloud Hosts</FONT></B><BR/><FONT POINT-SIZE="12">SSH 主机与远程桌面入口 · 远端工作连接</FONT>>,penwidth=2,margin=".12,.09"];D [shape=box,width=3.45,height=.62,color="#0659c4",fillcolor="white",label=<<B><FONT POINT-SIZE="17">员工操作</FONT></B><BR/><FONT POINT-SIZE="12">在授权范围内调用公开插件接口。</FONT>>,penwidth=2,margin=".12,.09"];F [shape=box,width=3.45,height=.62,color="#8a9c16",fillcolor="white",label=<<B><FONT POINT-SIZE="17">工作记录与文件</FONT></B><BR/><FONT POINT-SIZE="12">reading-notes.md · 文档重点、摘录与原文线索</FONT>>,penwidth=2,margin=".12,.09"];G [shape=box,width=3.45,height=.62,color="#0659c4",fillcolor="white",label=<<B><FONT POINT-SIZE="17">保存产物</FONT></B><BR/><FONT POINT-SIZE="12">资料与笔记保留在插件工作区。</FONT>>,penwidth=2,margin=".12,.09"];H [shape=box,width=3.45,height=.62,color="#bd4234",fillcolor="white",label=<<B><FONT POINT-SIZE="17">检查与交接</FONT></B><BR/><FONT POINT-SIZE="12">knowledge-index.md · 笔记结构、资料关系与研究问题</FONT>>,penwidth=2,margin=".12,.09"];O [shape=box,width=3.45,height=.62,color="#1c7045",fillcolor="white",label=<<B><FONT POINT-SIZE="17">阅读产物</FONT></B><BR/><FONT POINT-SIZE="12">摘录与文档线索</FONT>>,penwidth=2,margin=".12,.09"];N [shape=box,width=3.45,height=.62,color="#1c7045",fillcolor="white",label=<<B><FONT POINT-SIZE="17">继续协作</FONT></B><BR/><FONT POINT-SIZE="12">结果回到任务、消息与文件交接中。</FONT>>,penwidth=2,margin=".12,.09"];{rank=same;L0;A;B;}{rank=same;L1;C;}{rank=same;L2;R0;R1;R2;}{rank=same;L3;D;F;}{rank=same;L4;G;H;}{rank=same;L5;O;N;}L0->A [style=invis];L1->C [style=invis];L2->R0 [style=invis];L3->D [style=invis];L4->G [style=invis];L5->O [style=invis];L0->L1->L2->L3->L4->L5 [style=invis,weight=40];A->C;B->C;C->R0;C->R1;C->R2;R0->D;R1->D;R2->D;D->F;D->G;F->H;G->O;H->N;}