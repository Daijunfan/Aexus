digraph Avalon {graph [rankdir=TB,bgcolor="transparent",pad=.2,ranksep=0.28,nodesep=0.26,splines=ortho,outputorder=edgesfirst];node [fontname="Hiragino Sans GB",fontcolor="#111b22",style="filled",fillcolor="white"];edge [fontname="Hiragino Sans GB",fontsize=13,color="#3b4b53",penwidth=1.9,arrowsize=.68];L0 [shape=plaintext,fontname="Menlo",fontsize=12,fontcolor="#88959e",label="01 / 选定主题"];L1 [shape=plaintext,fontname="Menlo",fontsize=12,fontcolor="#88959e",label="02 / 配置来源"];L2 [shape=plaintext,fontname="Menlo",fontsize=12,fontcolor="#88959e",label="03 / 规定时段"];L3 [shape=plaintext,fontname="Menlo",fontsize=12,fontcolor="#88959e",label="04 / 安排早间任务"];L4 [shape=plaintext,fontname="Menlo",fontsize=12,fontcolor="#88959e",label="05 / 员工归纳"];L5 [shape=plaintext,fontname="Menlo",fontsize=12,fontcolor="#88959e",label="06 / 阅读与追问"];A [shape=box,width=3.45,height=.62,color="#3b4b53",fillcolor="white",label=<<B><FONT POINT-SIZE="17">目标与范围</FONT></B><BR/><FONT POINT-SIZE="12">一个持续关注的领域 · 决定简报关注哪些变化</FONT>>,penwidth=2,margin=".12,.09"];B [shape=box,width=3.45,height=.62,color="#3b4b53",fillcolor="white",label=<<B><FONT POINT-SIZE="17">材料与入口</FONT></B><BR/><FONT POINT-SIZE="12">你指定的订阅与作者 · 可以回到实际原文</FONT>>,penwidth=2,margin=".12,.09"];C [shape=box,width=5.4,height=.62,color="#0659c4",fillcolor="white",label=<<B><FONT POINT-SIZE="17">配置来源</FONT></B><BR/><FONT POINT-SIZE="12">接入你认可的频道与订阅。</FONT>>,penwidth=2,margin=".12,.09"];R0 [shape=box,width=2.65,height=.62,color="#0659c4",fillcolor="white",label=<<B><FONT POINT-SIZE="17">来源频道</FONT></B><BR/><FONT POINT-SIZE="12">持续保留新增内容 · 原始信息</FONT>>,penwidth=2,margin=".12,.09"];R1 [shape=box,width=2.65,height=.62,color="#0659c4",fillcolor="white",label=<<B><FONT POINT-SIZE="17">简报员工</FONT></B><BR/><FONT POINT-SIZE="12">整理指定时段的材料 · 重点与出处</FONT>>,penwidth=2,margin=".12,.09"];R2 [shape=box,width=2.65,height=.62,color="#0659c4",fillcolor="white",label=<<B><FONT POINT-SIZE="17">你</FONT></B><BR/><FONT POINT-SIZE="12">决定继续关注哪一项 · 下一步阅读与判断</FONT>>,penwidth=2,margin=".12,.09"];D [shape=box,width=3.45,height=.62,color="#0659c4",fillcolor="white",label=<<B><FONT POINT-SIZE="17">安排早间任务</FONT></B><BR/><FONT POINT-SIZE="12">用 Plan 设置合适的重复时间。</FONT>>,penwidth=2,margin=".12,.09"];F [shape=box,width=3.45,height=.62,color="#8a9c16",fillcolor="white",label=<<B><FONT POINT-SIZE="17">工作记录与文件</FONT></B><BR/><FONT POINT-SIZE="12">sources.md · 来源与关注主题的具体范围</FONT>>,penwidth=2,margin=".12,.09"];G [shape=box,width=3.45,height=.62,color="#0659c4",fillcolor="white",label=<<B><FONT POINT-SIZE="17">员工归纳</FONT></B><BR/><FONT POINT-SIZE="12">按关注点整理重点与原文线索。</FONT>>,penwidth=2,margin=".12,.09"];H [shape=box,width=3.45,height=.62,color="#bd4234",fillcolor="white",label=<<B><FONT POINT-SIZE="17">检查与交接</FONT></B><BR/><FONT POINT-SIZE="12">morning-brief.md · 重点、原文入口与问题</FONT>>,penwidth=2,margin=".12,.09"];O [shape=box,width=3.45,height=.62,color="#1c7045",fillcolor="white",label=<<B><FONT POINT-SIZE="17">重点速览</FONT></B><BR/><FONT POINT-SIZE="12">围绕主题的简明整理</FONT>>,penwidth=2,margin=".12,.09"];N [shape=box,width=3.45,height=.62,color="#1c7045",fillcolor="white",label=<<B><FONT POINT-SIZE="17">阅读与追问</FONT></B><BR/><FONT POINT-SIZE="12">看简报，再挑值得深读的内容。</FONT>>,penwidth=2,margin=".12,.09"];{rank=same;L0;A;B;}{rank=same;L1;C;}{rank=same;L2;R0;R1;R2;}{rank=same;L3;D;F;}{rank=same;L4;G;H;}{rank=same;L5;O;N;}L0->A [style=invis];L1->C [style=invis];L2->R0 [style=invis];L3->D [style=invis];L4->G [style=invis];L5->O [style=invis];L0->L1->L2->L3->L4->L5 [style=invis,weight=40];A->C;B->C;C->R0;C->R1;C->R2;R0->D;R1->D;R2->D;D->F;D->G;F->H;G->O;H->N;}