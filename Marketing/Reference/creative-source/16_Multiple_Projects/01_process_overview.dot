digraph Avalon {graph [rankdir=TB,bgcolor="transparent",pad=.2,ranksep=0.28,nodesep=0.26,splines=ortho,outputorder=edgesfirst];node [fontname="Hiragino Sans GB",fontcolor="#111b22",style="filled",fillcolor="white"];edge [fontname="Hiragino Sans GB",fontsize=13,color="#3b4b53",penwidth=1.9,arrowsize=.68];L0 [shape=plaintext,fontname="Menlo",fontsize=12,fontcolor="#88959e",label="01 / 划分项目"];L1 [shape=plaintext,fontname="Menlo",fontsize=12,fontcolor="#88959e",label="02 / 绑定工作区"];L2 [shape=plaintext,fontname="Menlo",fontsize=12,fontcolor="#88959e",label="03 / 配置员工"];L3 [shape=plaintext,fontname="Menlo",fontsize=12,fontcolor="#88959e",label="04 / 建立讨论"];L4 [shape=plaintext,fontname="Menlo",fontsize=12,fontcolor="#88959e",label="05 / 安排节奏"];L5 [shape=plaintext,fontname="Menlo",fontsize=12,fontcolor="#88959e",label="06 / 查找产物"];A [shape=box,width=3.45,height=.62,color="#3b4b53",fillcolor="white",label=<<B><FONT POINT-SIZE="17">目标与范围</FONT></B><BR/><FONT POINT-SIZE="12">产品 / 研究 / 内容 · 各自目标与产物范围</FONT>>,penwidth=2,margin=".12,.09"];B [shape=box,width=3.45,height=.62,color="#3b4b53",fillcolor="white",label=<<B><FONT POINT-SIZE="17">材料与入口</FONT></B><BR/><FONT POINT-SIZE="12">真实本地或远端工作区 · 文件位置与 Team 对应</FONT>>,penwidth=2,margin=".12,.09"];C [shape=box,width=5.4,height=.62,color="#0659c4",fillcolor="white",label=<<B><FONT POINT-SIZE="17">绑定工作区</FONT></B><BR/><FONT POINT-SIZE="12">每个 Team 指向实际目录或主机。</FONT>>,penwidth=2,margin=".12,.09"];R0 [shape=box,width=2.65,height=.62,color="#0659c4",fillcolor="white",label=<<B><FONT POINT-SIZE="17">产品项目</FONT></B><BR/><FONT POINT-SIZE="12">围绕产品需求分工 · 代码与交付材料</FONT>>,penwidth=2,margin=".12,.09"];R1 [shape=box,width=2.65,height=.62,color="#0659c4",fillcolor="white",label=<<B><FONT POINT-SIZE="17">研究项目</FONT></B><BR/><FONT POINT-SIZE="12">围绕研究问题组织 · 资料与研究笔记</FONT>>,penwidth=2,margin=".12,.09"];R2 [shape=box,width=2.65,height=.62,color="#0659c4",fillcolor="white",label=<<B><FONT POINT-SIZE="17">内容项目</FONT></B><BR/><FONT POINT-SIZE="12">围绕创作计划协作 · 选题与稿件</FONT>>,penwidth=2,margin=".12,.09"];D [shape=box,width=3.45,height=.62,color="#0659c4",fillcolor="white",label=<<B><FONT POINT-SIZE="17">建立讨论</FONT></B><BR/><FONT POINT-SIZE="12">按需要组织项目群组与频道。</FONT>>,penwidth=2,margin=".12,.09"];F [shape=box,width=3.45,height=.62,color="#8a9c16",fillcolor="white",label=<<B><FONT POINT-SIZE="17">工作记录与文件</FONT></B><BR/><FONT POINT-SIZE="12">project-map.md · 项目、成员与实际目录</FONT>>,penwidth=2,margin=".12,.09"];G [shape=box,width=3.45,height=.62,color="#0659c4",fillcolor="white",label=<<B><FONT POINT-SIZE="17">安排节奏</FONT></B><BR/><FONT POINT-SIZE="12">在 Plan 中按人员和任务跟进。</FONT>>,penwidth=2,margin=".12,.09"];H [shape=box,width=3.45,height=.62,color="#bd4234",fillcolor="white",label=<<B><FONT POINT-SIZE="17">检查与交接</FONT></B><BR/><FONT POINT-SIZE="12">project-notes.md · 各项目的进展和问题</FONT>>,penwidth=2,margin=".12,.09"];O [shape=box,width=3.45,height=.62,color="#1c7045",fillcolor="white",label=<<B><FONT POINT-SIZE="17">项目归属</FONT></B><BR/><FONT POINT-SIZE="12">员工和任务对应具体 Team</FONT>>,penwidth=2,margin=".12,.09"];N [shape=box,width=3.45,height=.62,color="#1c7045",fillcolor="white",label=<<B><FONT POINT-SIZE="17">查找产物</FONT></B><BR/><FONT POINT-SIZE="12">从文件树和资产视图找到材料。</FONT>>,penwidth=2,margin=".12,.09"];{rank=same;L0;A;B;}{rank=same;L1;C;}{rank=same;L2;R0;R1;R2;}{rank=same;L3;D;F;}{rank=same;L4;G;H;}{rank=same;L5;O;N;}L0->A [style=invis];L1->C [style=invis];L2->R0 [style=invis];L3->D [style=invis];L4->G [style=invis];L5->O [style=invis];L0->L1->L2->L3->L4->L5 [style=invis,weight=40];A->C;B->C;C->R0;C->R1;C->R2;R0->D;R1->D;R2->D;D->F;D->G;F->H;G->O;H->N;}